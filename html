/*
   IMPORTANT:

   We are not inventing the final Elkhart curve mileposts here.

   The engine is ready for the actual conductor notes / verified
   timetable data.

   The 30 MPH display anchor from Part 1 is therefore only a
   visual placeholder until the exact restriction is entered.
*/


/* ============================================================
   GET CURRENT SPEED RESTRICTION
   ============================================================ */

function getSpeedRestriction(
    milepost,
    direction
) {

    const applicable =
        CP.territory.speedRestrictions
            .filter(
                restriction => {

                    if (
                        !restriction.active
                    ) {
                        return false;
                    }


                    if (
                        restriction.direction
                        !== "both"
                        &&
                        restriction.direction
                        !== direction
                    ) {
                        return false;
                    }


                    const high =
                        Math.max(
                            restriction.beginMile,
                            restriction.endMile
                        );

                    const low =
                        Math.min(
                            restriction.beginMile,
                            restriction.endMile
                        );


                    return (
                        milepost <= high
                        &&
                        milepost >= low
                    );

                }
            );


    if (
        applicable.length === 0
    ) {
        return null;
    }


    return applicable
        .sort(
            (a, b) =>
                a.speed - b.speed
        )[0];

}


