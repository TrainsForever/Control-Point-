/* ============================================================
   5.2 DISPATCHER EVENT SYSTEM
   ============================================================ */

function dispatcherEvent(message, type = "normal") {

    const timestamp = new Date().toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });

    const entry = {
        time: timestamp,
        message,
        type
    };

    CP.dispatcher.lastAction = message;
    CP.dispatcher.lastActionTime = Date.now();

    if (!CP.dispatcherLog) {
        CP.dispatcherLog = [];
    }

    CP.dispatcherLog.unshift(entry);

    /*
       Keep the internal log from growing forever.
    */
    if (CP.dispatcherLog.length > 100) {
        CP.dispatcherLog.length = 100;
    }

    /*
       Existing radio/event system.
       We deliberately try several common structures so this
       layer does not destroy the existing Part 1–4 logger.
    */

    try {
        if (typeof addRadioLog === "function") {
            addRadioLog(message);
        }
    } catch (e) {}

    try {
        if (typeof radioLog === "function") {
            radioLog(message);
        }
    } catch (e) {}

    try {
        if (typeof addEventLog === "function") {
            addEventLog(message);
        }
    } catch (e) {}

    renderDispatcherLog();
}


