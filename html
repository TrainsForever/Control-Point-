function setSwitchPosition(
    switchId,
    position,
    routeId = null
) {

    const sw =
        CP.territory.switches
            .find(
                s =>
                    s.id === switchId
            );


    if (!sw) {
        return false;
    }


    if (
        sw.locked
        &&
        sw.lockedByRoute
        !== routeId
    ) {

        return false;

    }


    if (
        position !== "NORMAL"
        &&
        position !== "REVERSE"
    ) {

        return false;

    }


    sw.position =
        position;


    sw.lockedByRoute =
        routeId;


    renderSwitch(
        sw
    );


    return true;

}


