/* ============================================================
   BLOCK VISUAL STATE
   ============================================================ */

function renderBlockState(
    block
) {

    /*
       The actual visual segmentation will be connected to the
       signal/block renderer once the final signal locations are
       loaded.

       This function intentionally performs an abrupt state
       transition.

       No interpolation.
       No color tweening.
    */

    const line =
        document.getElementById(
            block.trackId === "main-1"
                ? "track-1"
                : block.trackId === "main-2"
                    ? "track-2"
                    : block.trackId === "main-3"
                        ? "track-3"
                        : block.trackId === "main-4"
                            ? "track-4"
                            : "track-siding"
        );


    if (!line) {
        return;
    }


    if (
        block.occupied
    ) {

        line.classList.remove(
            "lined"
        );

        line.classList.add(
            "occupied"
        );

    }
    else if (
        block.lined
    ) {

        line.classList.remove(
            "occupied"
        );

        line.classList.add(
            "lined"
        );

    }

}


