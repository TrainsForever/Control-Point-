   6.14 SIGNAL RENDER
   ============================================================ */

function drawATCSSignals(ctx) {

    ctx.save();

    for (
        const signal
        of ATCS_DISPLAY_SIGNALS
    ) {

        const x =
            ATCS_SCALE.mileToX(
                signal.mp
            );

        const y =
            getTrackY(
                signal.track
            );

        let indication =
            "STOP";

        /*
           Ask Part 3's signal engine first.
        */

        try {

            if (
                typeof getSignalIndication ===
                "function"
            ) {

                indication =
                    getSignalIndication(
                        signal.id
                    ) || "STOP";
            }

        } catch (e) {}

        /*
           If dispatcher is holding it, force Stop.
        */

        if (
            CP.dispatcher &&
            CP.dispatcher.heldSignals &&
            CP.dispatcher.heldSignals[
                signal.id
            ]
        ) {

            indication =
                "STOP";
        }

        const aspect =
            getATCSAspectColor(
                indication
            );

        /*
           Signal mast.
        */

        ctx.strokeStyle =
            "#777";

        ctx.lineWidth =
            1;

        ctx.beginPath();

        ctx.moveTo(
            x,
            y
        );

        ctx.lineTo(
            x,
            y - ATCS_BOARD.signalHeight
        );

        ctx.stroke();

        /*
           Signal lamp.
        */

        ctx.beginPath();

        ctx.arc(
            x,
            y - ATCS_BOARD.signalHeight,
            3,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            aspect;

        ctx.fill();

        /*
           Tiny signal ID.
        */

        ctx.font =
            "7px monospace";

        ctx.fillStyle =
            "#777";

        ctx.textAlign =
            "center";

        ctx.fillText(
            signal.id,
            x,
            y + 7
        );
    }

    ctx.restore();
}


function getATCSAspectColor(indication) {

    const value =
        String(
            indication || "STOP"
        ).toUpperCase();

    if (
        value === "STOP" ||
        value === "RESTRICTING"
    ) {

        return "#e32626";
    }

    if (
        value.includes("APPROACH")
    ) {

        return "#e6c928";
    }

    return "#20e85a";
}


/* ============================================================
   6.15 SWITCH RENDERING
   ============================================================ */

function drawATCSSwitches(ctx) {

    const switches =
        typeof SWITCHES !== "undefined" &&
        Array.isArray(SWITCHES)
            ? SWITCHES
            : [];

    ctx.save();

    ctx.lineWidth =
        1;

    for (
        const sw
        of switches
    ) {

        if (
            !Number.isFinite(
                Number(sw.mp)
            )
        ) {
            continue;
        }

        const x =
            ATCS_SCALE.mileToX(
                sw.mp
            );

        const y =
            getTrackY(
                sw.track ||
                "main1"
            );

        const position =
            String(
                sw.position ||
                sw.state ||
                "NORMAL"
            ).toUpperCase();

        ctx.strokeStyle =
            ATCS_BOARD.colors.switch;

        ctx.beginPath();

        ctx.moveTo(
            x - 7,
            y
        );

        if (
            position === "REVERSE"
        ) {

            ctx.lineTo(
                x + 7,
                y + 12
            );

        } else {

            ctx.lineTo(
                x + 7,
                y
            );
        }

        ctx.stroke();

        /*
           Clickable switch hit area is handled by the DOM
           overlay later.
        */
    }

    ctx.restore();
}


/* ============================================================
   6.16 SPEED RESTRICTIONS
   ============================================================ */

const ATCS_SPEED_RESTRICTIONS = [

