   ============================================================ */

/*
   A signal cannot display every possible indication.

   This is where the 2-head / 3-head distinction matters.

   We keep the dispatcher interaction simple while the engine
   respects the physical signal configuration.

   The final territory signal database will specify the actual
   head count for every signal.
*/

const SIGNAL_CAPABILITIES = {

    2: [

        "STOP",
        "CLEAR",
        "APPROACH",
        "APPROACH_MEDIUM",
        "APPROACH_SLOW",
        "RESTRICTING"

    ],

    3: [

        "STOP",
        "CLEAR",
        "APPROACH",
        "APPROACH_MEDIUM",
        "APPROACH_SLOW",
        "ADVANCE_APPROACH",
        "MEDIUM_CLEAR",
        "MEDIUM_APPROACH_MEDIUM",
        "LIMITED_CLEAR",
        "RESTRICTING"

    ]

};


/* ============================================================
   CAN SIGNAL DISPLAY INDICATION?
   ============================================================ */

function signalCanDisplay(
    signal,
    indication
) {

    if (!signal) {
        return false;
    }


    const capabilities =
        SIGNAL_CAPABILITIES[
            signal.heads
        ] || [];


    return capabilities.includes(
        indication
    );

}


/* ============================================================
   FIND NEXT SIGNAL
   ============================================================ */

function findNextSignal(
    signal
) {

    if (!signal) {
        return null;
    }


    if (
        signal.nextSignal
    ) {

        return getSignal(
            signal.nextSignal
        );

    }


    const signals =
        CP.territory.signals
            .filter(
                candidate => {

                    if (
                        candidate.trackId
                        !== signal.trackId
                    ) {
                        return false;
                    }


                    if (
                        candidate.direction
                        !== signal.direction
                    ) {
                        return false;
                    }


                    return true;

                }
            );


    if (
        signals.length === 0
    ) {

        return null;

    }


    /*
       Eastbound railroad movement travels toward lower
       mileposts.

       Westbound railroad movement travels toward higher
       mileposts.
    */

    if (
        signal.direction === "east"
    ) {

        const candidates =
            signals
                .filter(
                    s =>
                        s.milepost
                        < signal.milepost
                )
                .sort(
                    (a, b) =>
                        b.milepost
                        -
                        a.milepost
                );


        return candidates[0] || null;

    }


    const candidates =
        signals
            .filter(
                s =>
                    s.milepost
                    > signal.milepost
            )
            .sort(
                (a, b) =>
                    a.milepost
                    -
                    b.milepost
            );


    return candidates[0] || null;

}


/* ============================================================
   FIND PREVIOUS SIGNAL
   ============================================================ */

function findPreviousSignal(
    signal
) {

    if (!signal) {
        return null;
    }


    const signals =
        CP.territory.signals
            .filter(
                candidate => {

                    if (
                        candidate.trackId
                        !== signal.trackId
                    ) {
                        return false;
                    }


                    if (
                        candidate.direction
                        !== signal.direction
                    ) {
                        return false;
                    }


                    return true;

                }
            );


    if (
        signal.direction === "east"
    ) {

        const candidates =
            signals
                .filter(
                    s =>
                        s.milepost
                        > signal.milepost
                )
                .sort(
                    (a, b) =>
                        a.milepost
                        -
                        b.milepost
                );


        return candidates[0] || null;

    }


    const candidates =
        signals
            .filter(
                s =>
                    s.milepost
                    < signal.milepost
            )
            .sort(
                (a, b) =>
                    b.milepost
                    -
                    a.milepost
            );


    return candidates[0] || null;

}


/* ============================================================
   ROUTE OCCUPANCY CHECK
   ============================================================ */

function routeHasOccupiedBlock(
    route
) {

    if (!route) {
        return true;
    }


    return route.blocks.some(
        blockId => {

            const block =
                CP.territory.blocks
                    .find(
                        b =>
                            b.id === blockId
                    );


            return (
                block
                &&
                block.occupied
            );

        }
    );

}


/* ============================================================
   SWITCH CONFLICT CHECK
   ============================================================ */

function switchConflictExists(
    route
) {

    if (!route) {
        return true;
    }


    return route.switches.some(
        switchId => {

            const sw =
                CP.territory.switches
                    .find(
                        s =>
                            s.id === switchId
                    );


            if (!sw) {
                return true;
            }


            /*
               A switch locked by another route cannot be changed.
            */

            return (
                sw.locked
                &&
                sw.lockedByRoute
                !== route.id
            );

        }
    );

}


/* ============================================================
   ROUTE SAFETY CHECK
   ============================================================ */

function routeIsSafe(
    route
) {

    if (!route) {
        return false;
    }


    if (
        routeHasOccupiedBlock(
            route
        )
    ) {

        return false;

    }


    if (
        switchConflictExists(
            route
        )
    ) {

        return false;

    }


    if (
        routeConflicts(
            route
        )
    ) {

        return false;

    }


    return true;

}


/* ============================================================
   ALIGN ROUTE SWITCHES
   ============================================================ */

function alignRouteSwitches(
    route
) {

    if (!route) {
        return false;
    }


    route.switches.forEach(
        switchId => {

            const sw =
                CP.territory.switches
                    .find(
                        s =>
                            s.id === switchId
                    );


            if (!sw) {
                return;
            }


            /*
               Route definitions will eventually contain the exact
               required switch position.

               Until then, NORMAL is the default safe position.
            */

            if (
                !sw.locked
            ) {

                setSwitchPosition(
                    sw.id,
                    sw.requiredPosition
                        || "NORMAL",
                    route.id
                );

            }

        }
    );


    return true;

}


/* ============================================================
   LOCK ROUTE
   ============================================================ */

function lockRoute(
    route
) {

    if (!route) {
        return false;
    }


    route.locked =
        true;


    route.cleared =
        true;


    route.blocks.forEach(
        blockId => {

            const block =
                CP.territory.blocks
                    .find(
                        b =>
                            b.id === blockId
                    );


            if (!block) {
                return;
            }


            block.lined =
                true;


            block.linedFor =
                route.id;


            block.locked =
                true;


            if (
                !block.occupied
            ) {

                block.state =
                    "LINED";

            }


            renderBlockState(
                block
            );

        }
    );


    route.switches.forEach(
        switchId => {

            const sw =
                CP.territory.switches
                    .find(
                        s =>
                            s.id === switchId
                    );


            if (!sw) {
                return;
            }


            sw.locked =
                true;


            sw.lockedByRoute =
                route.id;

        }
    );


    return true;

}


/* ============================================================
   UNLOCK ROUTE
   ============================================================ */

function unlockRoute(
    route
) {

    if (!route) {
        return;
    }


    route.locked =
        false;


    route.cleared =
        false;


    route.requested =
        false;


    route.blocks.forEach(
        blockId => {

            const block =
                CP.territory.blocks
                    .find(
                        b =>
                            b.id === blockId
                    );


            if (!block) {
                return;
            }


            if (
                block.occupied
            ) {

                /*
                   Never remove occupancy simply because a route
                   was released.
                */

                return;

            }


            block.lined =
                false;


            block.linedFor =
                null;


            block.locked =
                false;


            block.state =
                "NORMAL";


            renderBlockState(
                block
            );

        }
    );


    route.switches.forEach(
        switchId => {

            const sw =
                CP.territory.switches
                    .find(
                        s =>
                            s.id === switchId
                    );


            if (!sw) {
                return;
            }


            if (
                sw.lockedByRoute
                === route.id
            ) {

                sw.locked =
                    false;

                sw.lockedByRoute =
                    null;

            }

        }
    );

}


/* ============================================================
   DETERMINE SIGNAL INDICATION
   ============================================================ */

function determineSignalIndication(
    signal
) {

    if (!signal) {
        return "STOP";
    }


    /*
       No cleared route means STOP.
    */

    if (
        !signal.routeId
    ) {

        return "STOP";

    }


    const route =
        CP.routes.find(
            r =>
                r.id
                === signal.routeId
        );


    if (
        !route
        ||
        !route.cleared
    ) {

        return "STOP";

    }


    /*
       Occupied route = stop protection.
    */

    if (
        routeHasOccupiedBlock(
            route
        )
    ) {

        return "STOP";

    }


    const nextSignal =
        getSignal(
            route.destinationSignalId
        )
        ||
        findNextSignal(
            signal
        );


    if (!nextSignal) {

        return "CLEAR";

    }


    /*
       Look at the next signal's indication.

       This creates the signal chain.
    */

    const nextIndication =
        nextSignal.indication;


    if (
        nextIndication === "STOP"
    ) {

        /*
           The exact physical aspect can depend on the signal
           configuration.

           For the underlying operating logic, the train is
           approaching a stop signal.
        */

        if (
            signalCanDisplay(
                signal,
                "APPROACH"
            )
        ) {

            return "APPROACH";

        }


        return "STOP";

    }


    if (
        nextIndication
        === "APPROACH"
    ) {

        if (
            signalCanDisplay(
                signal,
                "ADVANCE_APPROACH"
            )
        ) {

            return "ADVANCE_APPROACH";

        }


        if (
            signalCanDisplay(
                signal,
                "APPROACH"
            )
        ) {

            return "APPROACH";

        }


        return "STOP";

    }


    if (
        nextIndication
        === "APPROACH_MEDIUM"
    ) {

        if (
            signalCanDisplay(
                signal,
                "MEDIUM_APPROACH_MEDIUM"
            )
        ) {

            return "MEDIUM_APPROACH_MEDIUM";

        }


        if (
            signalCanDisplay(
                signal,
                "APPROACH_MEDIUM"
            )
        ) {

            return "APPROACH_MEDIUM";

        }


        return "APPROACH";

    }


    if (
        nextIndication
        === "APPROACH_SLOW"
    ) {

        if (
            signalCanDisplay(
                signal,
                "APPROACH_SLOW"
            )
        ) {

            return "APPROACH_SLOW";

        }


        return "APPROACH";

    }


    /*
       If the next signal is permissive, the route can normally
       proceed at the applicable authorized speed unless a
       physical restriction or route condition imposes something
       lower.
    */

    if (
        nextIndication
        === "CLEAR"
    ) {

        if (
            signalCanDisplay(
                signal,
                "CLEAR"
            )
        ) {

            return "CLEAR";

        }

    }


    /*
       Default safe fallback.
    */

    if (
        signalCanDisplay(
            signal,
            "APPROACH"
        )
    ) {

        return "APPROACH";

    }


    return "STOP";

}


/* ============================================================
   APPLY SIGNAL INDICATION
   ============================================================ */

function applySignalIndication(
    signal,
    indication
) {

    if (!signal) {
        return;
    }


    if (
        !signalCanDisplay(
            signal,
            indication
        )
    ) {

        signal.indication =
            "STOP";

        updatePhysicalSignalHeads(
            signal
        );

        renderSignal(
            signal
        );

        return;

    }


    signal.indication =
        indication;


    updatePhysicalSignalHeads(
        signal
    );


    renderSignal(
        signal
    );

}


/* ============================================================
   UPDATE SIGNAL CHAIN
   ============================================================ */

function updateSignalChain() {

    CP.territory.signals
        .forEach(
            signal => {

                const indication =
                    determineSignalIndication(
                        signal
                    );


                applySignalIndication(
                    signal,
                    indication
                );

            }
        );

}


/* ============================================================
   SIGNAL BOARD RENDERER
   ============================================================ */

function renderSignal(
    signal
) {

    const element =
        document.querySelector(
            `[data-signal-id="${signal.id}"]`
        );


    if (!element) {
        return;
    }


    const heads =
        element.querySelectorAll(
            ".signalHead"
        );


    heads.forEach(
        (head, index) => {

            head.classList.remove(
                "red",
                "green",
                "yellow"
            );


            const state =
                signal.aspectHeads[
                    index
                ];


            if (
                state
                &&
                state !== "off"
            ) {

                head.classList.add(
                    state
                );

            }

        }
    );


    element.title =
        signal.name
        + " — "
        + signal.indication;

}


/* ============================================================
   CREATE SIGNAL BOARD ELEMENT
   ============================================================ */

function renderSignalElement(
    signal,
    trackTop
) {

    const canvas =
        document.getElementById(
            "territoryCanvas"
        );


    const element =
        document.createElement(
            "div"
        );


    element.className =
        "signal";


    element.dataset.signalId =
        signal.id;


    element.style.left =
        (
            mileToPixel(
                signal.milepost
            ) - 9
        )
        + "px";


    element.style.top =
        (
            trackTop - 2
        )
        + "px";


    element.addEventListener(
        "click",
        event => {

            event.stopPropagation();

            selectSignal(
                signal.id,
                event
            );

        }
    );


    const mast =
        document.createElement(
            "div"
        );


    mast.className =
        "signalMast";


    element.appendChild(
        mast
    );


    const heads =
        document.createElement(
            "div"
        );


    heads.className =
        "signalHeads";


    for (
        let i = 0;
        i < signal.heads;
        i++
    ) {

        const head =
            document.createElement(
                "div"
            );


        head.className =
            "signalHead";


        heads.appendChild(
            head
        );

    }


    element.appendChild(
        heads
    );


    const label =
        document.createElement(
            "div"
        );


    label.className =
        "signalLabel";


    label.textContent =
        signal.name;


    element.appendChild(
        label
    );


    canvas.appendChild(
        element
    );


    renderSignal(
        signal
    );

}


/* ============================================================
   SELECT SIGNAL
   ============================================================ */

function selectSignal(
    signalId,
    event
) {

    const signal =
        getSignal(
            signalId
        );


    if (!signal) {
        return;
    }


    CP.selectedSignalId =
        signalId;


    const popup =
        document.getElementById(
            "routePopup"
        );


    popup.classList.add(
        "visible"
    );


    /*
       Position popup beside the clicked signal.
    */

    let x =
        event.clientX + 8;

    let y =
        event.clientY + 8;


    const width =
        220;


    const height =
        140;


    if (
        x + width
        >
        window.innerWidth
    ) {

        x =
            window.innerWidth
            - width
            - 8;

    }


    if (
        y + height
        >
        window.innerHeight
    ) {

        y =
            window.innerHeight
            - height
            - 8;

    }


    popup.style.left =
        x + "px";


    popup.style.top =
        y + "px";


    radioLog(
        signal.name
        + " selected — "
        + signal.indication,
        "dispatcher"
    );

}


