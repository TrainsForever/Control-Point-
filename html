/* ============================================================
   7.26 AUTOMATIC RADIO START CONDITIONS
   ============================================================ */

function updateAutomaticTrainRadio(
    train
) {

    if (!train) {
        return;
    }

    initializeTrainRadio(train);

    /*
       Don't interfere with emergencies.
    */

    if (
        train.radioState.state ===
        "EMERGENCY"
    ) {

        return;
    }

    /*
       Don't interfere with an active conversation.
    */

    const activeStates = [

        "CALLING_DISPATCHER",

        "AWAITING_CREW",

        "CREW_READY",

        "WAITING_FOR_TRAINS",

        "DISPATCHER_HOLD"
    ];

    if (
        activeStates.includes(
            train.radioState.state
        )
    ) {

        return;
    }

    /*
       Train stopped and not yet released:
       initiate the dispatcher call.

       We deliberately require a train to be near an
       appropriate departure/interface point.

       The final yard-interface database will replace this
       generic condition.
    */

    const speed =
        Number(
            train.speed || 0
        );

    const stopped =
        speed <= 0.5;

    const notDeparted =
        !train.hasDeparted;

    if (
        stopped &&
        notDeparted &&
        !train.emergency
    ) {

        /*
           Prevent repeated calls.
        */

        const now =
            Date.now();

        if (
            now -
            train.radioState.lastCall >
            15000
        ) {

            train.radioState.lastCall =
                now;

            trainCallDispatcher(
                train
            );
        }
    }
}


/* ============================================================
   7.27 RADIO STATE UPDATE
   ============================================================ */

function updateRadioSystem() {

    if (
        typeof CP === "undefined" ||
        !Array.isArray(CP.trains)
    ) {

        return;
    }

    CP.trains.forEach(
        train => {

            initializeTrainRadio(
                train
            );

            updateTrainRadioWaiting(
                train
            );

            updateAutomaticTrainRadio(
                train
            );
        }
    );
}


/* ============================================================
   7.28 HOOK RADIO INTO SIMULATION
   ============================================================ */

(function installRadioSimulationHook() {

    if (
        window.__cpRadioHookInstalled
    ) {

        return;
    }

    const previous =
        window.updateSimulation;

    if (
        typeof previous ===
        "function"
    ) {

        window.updateSimulation =
            function(...args) {

                previous.apply(
                    this,
                    args
                );

                updateRadioSystem();
            };

        window.__cpRadioHookInstalled =
            true;
    }

})();


/* ============================================================
   7.29 TRAIN DEPARTURE AUTHORITY
   ============================================================ */

function canTrainDepart(
    train
) {

    if (!train) {
        return false;
    }

    initializeTrainRadio(
        train
    );

    const state =
        train.radioState.state;

    /*
       Emergency = absolutely no movement.
    */

    if (
        state ===
        "EMERGENCY"
    ) {

        return false;
    }

    /*
       Dispatcher hold = no movement.
    */

    if (
        state ===
        "DISPATCHER_HOLD"
    ) {

        return false;
    }

    /*
       Waiting for trains = no movement.
    */

    if (
        state ===
        "WAITING_FOR_TRAINS"
    ) {

        return false;
    }

    /*
       Signal authority must exist.
    */

    if (
        !train.signalAuthority
    ) {

        return false;
    }

    /*
       Signal must not be STOP.
    */

    const signal =
        String(
            train.radioSignal ||
            ""
        ).toUpperCase();

    if (
        signal === "STOP"
    ) {

        return false;
    }

    return true;
}


/* ============================================================
   7.30 APPLY RADIO MOVEMENT AUTHORITY
   ============================================================ */

function applyRadioMovementAuthority(
    train
) {

    if (!train) {
        return;
    }

    if (
        canTrainDepart(
            train
        )
    ) {

        train.hasDeparted =
            true;

        /*
           Don't force a speed here.

           Part 4's physics engine determines acceleration,
           braking, authorized speed, and actual position.
        */

        train.radioState.state =
            "MOVING";

        dispatcherEvent(
            `${getTrainRadioID(train)} DEPARTURE AUTHORITY ACTIVE`
        );
    }
}


/* ============================================================
   7.31 MOVEMENT AUTHORITY UPDATE
