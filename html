function drawATCSBaseTracks(ctx) {

    ctx.save();

    ctx.lineWidth =
        ATCS_BOARD.trackHeight;

    ctx.strokeStyle =
        ATCS_BOARD.colors.track;

    /*
       Main Track 1
    */

    drawTrackLine(
        ctx,
        ATCS_BOARD.trackRows.main1
    );

    /*
       Main Track 2
    */

    drawTrackLine(
        ctx,
        ATCS_BOARD.trackRows.main2
    );

    /*
       Siding
    */

    drawTrackLine(
        ctx,
        ATCS_BOARD.trackRows.siding
    );

    /*
       Additional schematic track rows.
       These allow territory data to represent areas where
       more controlled tracks exist without drawing yards.
    */

    drawTrackLine(
        ctx,
        ATCS_BOARD.trackRows.main3
    );

    drawTrackLine(
        ctx,
        ATCS_BOARD.trackRows.main4
    );

    ctx.restore();
}


function drawTrackLine(ctx, y) {

    ctx.beginPath();

    ctx.moveTo(
        0,
        y
    );

    ctx.lineTo(
        ATCS_BOARD.width,
        y
    );

    ctx.stroke();
}


