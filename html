/* ============================================================
   8.13 TRAFFIC CONFLICT DETECTION
   ============================================================ */

function trainsAreOnCollisionCourse(
    trainA,
    trainB
) {

    if (
        !trainA ||
        !trainB
    ) {

        return false;
    }

    if (
        trainA ===
        trainB
    ) {

        return false;
    }

    const aMP =
        Number(
            trainA.mp
        );

    const bMP =
        Number(
            trainB.mp
        );

    if (
        !Number.isFinite(aMP) ||
        !Number.isFinite(bMP)
    ) {

        return false;
    }

    /*
       Different tracks are not automatically safe.

       Final route topology will determine actual conflicts.

       For now this is a conservative warning zone.
    */

    const separation =
        Math.abs(
            aMP -
            bMP
        );

    if (
        separation >
        2
    ) {

        return false;
    }

    const aDirection =
        String(
            trainA.direction ||
            ""
        ).toUpperCase();

    const bDirection =
        String(
            trainB.direction ||
            ""
        ).toUpperCase();

    /*
       Opposing trains on nearby territory.
    */

    if (
        (
            aDirection.includes(
                "EAST"
            ) &&
            bDirection.includes(
                "WEST"
            )
        ) ||
        (
            aDirection.includes(
                "WEST"
            ) &&
            bDirection.includes(
                "EAST"
            )
        )
    ) {

        return true;
    }

    /*
       Same direction with insufficient separation.
    */

    const aSpeed =
        Number(
            trainA.speed ||
            0
        );

    const bSpeed =
        Number(
            trainB.speed ||
            0
        );

    if (
        aDirection ===
        bDirection &&
        Math.abs(
            aSpeed -
            bSpeed
        ) > 10
    ) {

        return true;
    }

    return false;
}


/* ============================================================
   8.14 COLLISION WARNING
   ============================================================ */

function checkTrafficConflicts() {

    if (
        !Array.isArray(
            CP.trains
        )
    ) {

        return;
    }

    for (
        let i = 0;
        i < CP.trains.length;
        i++
    ) {

        for (
            let j = i + 1;
            j < CP.trains.length;
            j++
        ) {

            const a =
                CP.trains[i];

            const b =
                CP.trains[j];

            if (
                trainsAreOnCollisionCourse(
                    a,
                    b
                )
            ) {

                issueDispatcherWarning(
                    a,
                    b
                );
            }
        }
    }
}


/* ============================================================
   8.15 DISPATCHER WARNING
   ============================================================ */

const CP_WARNING_COOLDOWN =
    {};

function issueDispatcherWarning(
    trainA,
    trainB
) {

    const a =
        getTrainRadioID(
            trainA
        );

    const b =
        getTrainRadioID(
            trainB
        );

    const key =
        [a, b]
            .sort()
            .join("|");

    const now =
        Date.now();

    if (
        CP_WARNING_COOLDOWN[key] &&
        now -
        CP_WARNING_COOLDOWN[key] <
        10000
    ) {

        return;
    }

    CP_WARNING_COOLDOWN[key] =
        now;

    dispatcherEvent(
        `WARNING — ${a} / ${b} CLOSE PROXIMITY`,
        "warning"
    );
}


/* ============================================================
   8.16 TRAFFIC GENERATION
   ============================================================ */

function generateTrafficTrain() {

    if (
        !CP.traffic.enabled
    ) {

        return null;
    }

    if (
        !Array.isArray(
            CP.trains
        )
    ) {

        return null;
    }

    if (
        CP.trains.length >=
        CP.traffic.maximumActiveTrains
    ) {

        return null;
    }

    const now =
        Date.now();

    if (
        now -
        CP.traffic.lastGeneration <
        CP.traffic.minimumSpawnGap
    ) {

        return null;
    }

    CP.traffic.lastGeneration =
        now;

    /*
       Choose a plan.

       Hotshot/intermodal traffic receives a greater chance
       during busy traffic periods.
    */

    const plan =
        OPERATING_PLANS[
            Math.floor(
                Math.random() *
                OPERATING_PLANS.length
            )
        ];

    return createTrafficTrain(
        plan
    );
}


/* ============================================================
   8.17 INITIAL TRAFFIC
   ============================================================ */

function initializeTrafficScenario() {

    /*
       We want enough traffic to test the railroad without
       instantly filling the board.

       Existing 33G from Part 4 is preserved.
    */

    if (
        typeof CP.trains ===
        "undefined"
    ) {

        CP.trains = [];
    }

    /*
       Add 35J if it isn't already present.
    */

    if (
        !CP.trains.some(
            train =>
                getTrainRadioID(
                    train
                ) ===
                "35J"
        )
    ) {

        const train =
            createTrafficTrain(
                OPERATING_PLANS[0]
            );

        if (train) {

            train.hasDeparted =
                false;

            addTrainToYardQueue(
                train,
                "Chicago"
            );

            markTrainYardReady(
                train
            );
        }
    }

    /*
       Add a second train approaching the opposite end of
       the same operating area.

       This gives the dispatcher something to manage.
    */

    if (
        !CP.trains.some(
            train =>
                getTrainRadioID(
                    train
                ) ===
                "34G"
        )
    ) {

        const train =
            createTrafficTrain(
                OPERATING_PLANS[1]
            );

        if (train) {

            train.mp =
                421.5;

            train.track =
                "main2";

            train.speed =
                0;

            train.hasDeparted =
                false;

            addTrainToYardQueue(
                train,
                "Elkhart"
            );

            markTrainYardReady(
                train
            );
        }
    }

    dispatcherEvent(
        "INITIAL OPERATING TRAFFIC LOADED"
    );
}


/* ============================================================
   8.18 AUTOMATIC TRAFFIC TIMER
   ============================================================ */

function updateTrafficGenerator() {

    /*
       Only generate automatically after the initial traffic
       has settled.

       This keeps the first test understandable.
    */

    if (
        !CP.traffic.enabled
    ) {

        return;
    }

    const now =
        Date.now();

    /*
       45 seconds minimum between generated trains.
    */

    if (
        now -
        CP.traffic.lastGeneration <
        CP.traffic.minimumSpawnGap
    ) {

        return;
    }

    /*
       Don't constantly flood the dispatcher.
    */

    if (
        CP.trains.length >=
        CP.traffic.maximumActiveTrains
    ) {

        return;
    }

    /*
       Moderate generation probability.
    */

    if (
        Math.random() <
        0.20
    ) {

        generateTrafficTrain();
    }
}


/* ============================================================
   8.19 TRAFFIC UPDATE HOOK
   ============================================================ */

function updateTrafficSystem() {

    if (
        !Array.isArray(
            CP.trains
        )
    ) {

        return;
    }

    CP.trains.forEach(
        train => {

            initializeTrainRadio(
                train
            );
        }
    );

    checkTrafficConflicts();

    updateTrafficGenerator();

    renderTrafficQueue();
}


/* ============================================================
   8.20 INSTALL TRAFFIC HOOK
   ============================================================ */

(function installTrafficHook() {

    if (
        window.__cpTrafficHookInstalled
    ) {

        return;
    }

    const previous =
        window.updateDispatcherControlLayer;

    if (
        typeof previous ===
        "function"
    ) {

        window.updateDispatcherControlLayer =
            function(...args) {

                previous.apply(
                    this,
                    args
                );

                updateTrafficSystem();
            };

        window.__cpTrafficHookInstalled =
            true;
    }

})();


/* ============================================================
   8.21 MANUAL TRAFFIC GENERATOR
   ============================================================ */

function createTrafficTestButton() {

    if (
        document.getElementById(
            "cp-create-traffic"
        )
    ) {

        return;
    }

    const button =
        document.createElement(
            "button"
        );

    button.id =
        "cp-create-traffic";

    button.textContent =
        "NEW TRAIN";

    button.style.position =
        "fixed";

    button.style.right =
        "10px";

    button.style.bottom =
        "215px";

    button.style.zIndex =
        "10000";

    button.style.background =
        "#111";

    button.style.border =
        "1px solid #555";

    button.style.color =
        "#bbb";

    button.style.fontFamily =
        "monospace";

    button.style.fontSize =
        "9px";

    button.style.padding =
        "5px 7px";

    button.addEventListener(
        "click",
        () => {

            const train =
                generateTrafficTrain();

            if (!train) {

                dispatcherEvent(
                    "NO TRAIN GENERATED — TRAFFIC LIMIT OR COOLDOWN"
                );

            }
        }
    );

    document.body.appendChild(
        button
    );
}


/* ============================================================
   8.22 INITIALIZE TRAFFIC
   ============================================================ */

function initializeTrafficSystem() {

    initializeTrafficScenario();

    createTrafficTestButton();

    renderTrafficQueue();

    dispatcherEvent(
        "TRAFFIC MANAGEMENT SYSTEM ONLINE"
    );

    dispatcherEvent(
        "YARD / MAINLINE TRAFFIC QUEUE ACTIVE"
    );
}


/* ============================================================
   8.23 START TRAFFIC SYSTEM
   ============================================================ */

if (
    document.readyState ===
    "loading"
) {

    document.addEventListener(
        "DOMContentLoaded",
        initializeTrafficSystem,
        {
            once: true
        }
    );

} else {

    initializeTrafficSystem();
}


