/* ============================================================
   REQUEST ROUTE FROM SELECTED SIGNAL
   ============================================================ */

document
    .getElementById(
        "clearSignalButton"
    )
    .addEventListener(
        "click",
        () => {

            if (
                !CP.selectedSignalId
            ) {

                return;

            }


            const signal =
                getSignal(
                    CP.selectedSignalId
                );


            if (!signal) {
                return;
            }


            /*
               Find a route originating from this signal.

               The final territory data will contain explicit
               route definitions.
            */

            const route =
                CP.routes.find(
                    r =>
                        r.signalId
                        === signal.id
                );


            if (!route) {

                radioLog(
                    signal.name
                    + ": no valid route available.",
                    "alert"
                );

                notify(
                    "NO ROUTE AVAILABLE",
                    "red"
                );

                return;

            }


            const requested =
                requestRoute(
                    route.id
                );


            if (!requested) {
                return;
            }


            if (
                !routeIsSafe(
                    route
                )
            ) {

                route.requested =
                    false;


                radioLog(
                    signal.name
                    + ": route cannot be cleared.",
                    "alert"
                );

                notify(
                    "ROUTE NOT CLEAR",
                    "red"
                );

                return;

            }


            alignRouteSwitches(
                route
            );


            lockRoute(
                route
            );


            signal.routeId =
                route.id;


            signal.routeLocked =
                true;


            updateSignalChain();


            radioLog(
                signal.name
                + ": route cleared.",
                "dispatcher"
            );


            notify(
                signal.name
                + " ROUTE CLEARED",
                "green"
            );


            document
                .getElementById(
                    "routePopup"
                )
                .classList.remove(
                    "visible"
                );

        }
    );


/* ============================================================
   CONTACT TRAIN FROM SIGNAL
   ============================================================ */

document
    .getElementById(
        "callSignalButton"
    )
    .addEventListener(
        "click",
        () => {

            const signal =
                getSignal(
                    CP.selectedSignalId
                );


            if (!signal) {
                return;
            }


            const train =
                CP.trains.find(
                    candidate => {

                        const distance =
                            Math.abs(
                                candidate.position
                                -
                                signal.milepost
                            );


                        return (
                            distance < 2
                            &&
                            candidate.trackId
                            === signal.trackId
                        );

                    }
                );


            if (!train) {

                radioLog(
                    signal.name
                    + ": no train within communication range.",
                    "alert"
                );

                notify(
                    "NO TRAIN AT SIGNAL",
                    "yellow"
                );

                return;

            }


            initiateTrainRadioCall(
                train
            );


            document
                .getElementById(
                    "routePopup"
                )
                .classList.remove(
                    "visible"
                );

        }
    );


/* ============================================================
   HOLD / STOP SELECTED SIGNAL
   ============================================================ */

document
    .getElementById(
        "stopSignalButton"
    )
    .addEventListener(
        "click",
        () => {

            const signal =
                getSignal(
                    CP.selectedSignalId
                );


            if (!signal) {
                return;
            }


            signal.routeId =
                null;


            signal.routeLocked =
                false;


            signal.indication =
                "STOP";


            updatePhysicalSignalHeads(
                signal
            );


            renderSignal(
                signal
            );


            radioLog(
                signal.name
                + ": signal held at STOP.",
                "dispatcher"
            );


            notify(
                signal.name
                + " HELD",
                "red"
            );


            document
                .getElementById(
                    "routePopup"
                )
                .classList.remove(
                    "visible"
                );

        }
    );


