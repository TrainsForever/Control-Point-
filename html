/* ============================================================
   TRAIN TYPES
   ============================================================ */

const TRAIN_TYPES = {

    INTERMODAL: {

        defaultLength: 9000,

        defaultMass: 12000,

        acceleration: 0.050,

        braking: 0.060

    },

    MANIFEST: {

        defaultLength: 10000,

        defaultMass: 15000,

        acceleration: 0.032,

        braking: 0.050

    },

    UNIT: {

        defaultLength: 8000,

        defaultMass: 16000,

        acceleration: 0.030,

        braking: 0.048

    },

    LOCAL: {

        defaultLength: 2500,

        defaultMass: 4000,

        acceleration: 0.040,

        braking: 0.070

    }

};


/* ============================================================
   CREW VOICES
   ============================================================ */

/*
   Each train receives ONE crew identity.

   It remains attached to that train for the entire trip.

   Actual generated/audio voices will be connected later.
*/

const CREW_VOICES = [

    {
        id: "crew-01",
        name: "Crew 01"
    },

    {
        id: "crew-02",
        name: "Crew 02"
    },

    {
        id: "crew-03",
        name: "Crew 03"
    },

    {
        id: "crew-04",
        name: "Crew 04"
    },

    {
        id: "crew-05",
        name: "Crew 05"
    },

    {
        id: "crew-06",
        name: "Crew 06"
    },

    {
        id: "crew-07",
        name: "Crew 07"
    },

    {
        id: "crew-08",
        name: "Crew 08"
    }

];


function assignCrewVoice() {

    return CREW_VOICES[
        randomInt(
            0,
            CREW_VOICES.length - 1
        )
    ];

}


/* ============================================================
   TRAIN STATUS VALUES
   ============================================================ */

const TRAIN_STATUS = {

    MOVING: "MOVING",

    STOPPED: "STOPPED",

    WAITING: "WAITING",

    DEPARTING: "DEPARTING",

    ARRIVING: "ARRIVING",

    INSPECTION: "INSPECTION",

    EMERGENCY: "EMERGENCY",

    CREW_EXPIRED: "CREW EXPIRED",

    COMPLETE: "COMPLETE"

};


/* ============================================================
   CREATE TRAIN
   ============================================================ */

function createTrain({

    symbol,

    origin,

    destination,

    direction,

    position,

    trackId = "main-1",

    type = "MANIFEST",

    length = null,

    priority = 3,

    initialSpeed = 0,

    signalIndication = "STOP",

    authority = false

}) {

    const trainType =
        TRAIN_TYPES[type]
        ||
        TRAIN_TYPES.MANIFEST;


    const crew =
        assignCrewVoice();


    const train = {

        id:
            generateId("TRAIN"),


        symbol,

        origin,

        destination,

        direction,


        /*
           Milepost of the locomotive/front of train.
        */

        position,


        /*
           Position of the rear end.

           For an eastbound train moving toward lower
           mileposts, the rear is at a HIGHER milepost.

           For westbound movement, the rear is at a LOWER
           milepost.
        */

        rearPosition:
            position
            +
            (
                direction === "east"
                    ? 0
                    : 0
            ),


        trackId,


        type,


        length:
            length
            ||
            trainType.defaultLength,


        mass:
            trainType.defaultMass,


        priority,


        speed:
            initialSpeed,


        targetSpeed:
            initialSpeed,


        permittedSpeed:
            initialSpeed,


        signalIndication,


        authority,


        status:
            initialSpeed > 0
                ? TRAIN_STATUS.MOVING
                : TRAIN_STATUS.STOPPED,


        crewVoiceId:
            crew.id,


        crewVoiceName:
            crew.name,


        /*
           Twelve GAME hours.

           Because the game runs at 3× speed, this becomes
           four real hours.
        */

        crewMinutes:
            12 * 60,


        routeId:
            null,


        currentBlockId:
            null,


        previousBlockId:
            null,


        lastDisplayedBlockId:
            null,


        /*
           Detector tracking.
        */

        detectorsTriggered:
            [],


        /*
           Physical operating state.
        */

        braking:
            false,


        accelerating:
            false,


        emergency:
            false,


        stoppedAtSignal:
            null,


        lastSignalPassed:
            null,


        /*
           Radio state machine.
        */

        radioState:
            "QUIET",


        radioQueue:
            [],


        /*
           Yard departure / roll-by.
        */

        yardRestricted:
            false,


        rollByActive:
            false,


        rollByComplete:
            false,


        /*
           Temporary restrictions.
        */

        activeRestriction:
            null,


        /*
           Visual tag element.
        */

        tagElement:
            null

    };


    /*
       Calculate rear position from physical train length.
    */

    updateTrainRearPosition(
        train
    );


    CP.trains.push(
        train
    );


    createTrainTag(
        train
    );


    updateTrainBlock(
        train
    );


    updateTrainList();


    updateTrafficDisplay();


    return train;

}


/* ============================================================
   TRAIN LENGTH → MILEPOST DISTANCE
   ============================================================ */

/*
   One mile = 5280 feet.

   The board uses railroad mileposts.
   Train length is stored in feet.
*/

function feetToMiles(
    feet
) {

    return feet / 5280;

}


/* ============================================================
   UPDATE TRAIN REAR POSITION
   ============================================================ */

function updateTrainRearPosition(
    train
) {

    const lengthMiles =
        feetToMiles(
            train.length
        );


    if (
        train.direction === "east"
    ) {

        /*
           Eastbound locomotive is ahead toward decreasing
           milepost numbers.

           Rear remains behind toward higher MP.
        */

        train.rearPosition =
            train.position
            +
            lengthMiles;

    }
    else {

        /*
           Westbound locomotive is ahead toward increasing
           milepost numbers.

           Rear remains behind toward lower MP.
        */

        train.rearPosition =
            train.position
            -
            lengthMiles;

    }

}


/* ============================================================
   MPH → MILES PER SECOND
   ============================================================ */

function mphToMilesPerSecond(
    mph
) {

    return mph / 3600;

}


/* ============================================================
   GET AUTHORIZED SPEED
   ============================================================ */

function getTrainAuthorizedSpeed(
    train
) {

    let authorized =
        Infinity;


    /*
       ----------------------------------------------------------
       SIGNAL AUTHORITY
       ----------------------------------------------------------
    */

    const signalRule =
        SIGNAL_RULES[
            normalizeSignalKey(
                train.signalIndication
            )
        ];


    if (signalRule) {

        if (
            signalRule.permittedSpeed
            !== Infinity
        ) {

            authorized =
                Math.min(
                    authorized,
                    signalRule.permittedSpeed
                );

        }

    }


    /*
       ----------------------------------------------------------
       TRACK SPEED
       ----------------------------------------------------------
    */

    const track =
        CP.territory.tracks
            .find(
                t =>
                    t.id === train.trackId
            );


    if (track) {

        authorized =
            Math.min(
                authorized,
                track.defaultSpeed
            );

    }


    /*
       ----------------------------------------------------------
       SPEED RESTRICTION
       ----------------------------------------------------------
    */

    const restriction =
        getSpeedRestriction(
            train.position,
            train.direction
        );


    if (restriction) {

        authorized =
            Math.min(
                authorized,
                restriction.speed
            );


        train.activeRestriction =
            restriction;

    }
    else {

        train.activeRestriction =
            null;

    }


    /*
       ----------------------------------------------------------
       YARD / ROLL-BY RESTRICTION
       ----------------------------------------------------------
    */

    if (
        train.yardRestricted
        ||
        train.rollByActive
    ) {

        authorized =
            Math.min(
                authorized,
                TRAIN_PHYSICS.yardSpeed
            );

    }


    /*
       ----------------------------------------------------------
       EMERGENCY
       ----------------------------------------------------------
    */

    if (
        train.emergency
    ) {

        return 0;

    }


    /*
       ----------------------------------------------------------
       CREW EXPIRED
       ----------------------------------------------------------
    */

    if (
        train.crewMinutes <= 0
    ) {

        return 0;

    }


    return Math.max(
        0,
        authorized
    );

}


/* ============================================================
   SIGNAL INDICATION KEY NORMALIZATION
   ============================================================ */

function normalizeSignalKey(
    indication
) {

    if (!indication) {
        return "STOP";
    }


    return indication
        .toUpperCase()
        .replace(
            / /g,
            "_"
        );

}


/* ============================================================
   DETERMINE TARGET SPEED
   ============================================================ */

function updateTrainTargetSpeed(
    train
) {

    const authorized =
        getTrainAuthorizedSpeed(
            train
        );


    train.permittedSpeed =
        authorized;


    /*
       No authority = stop.

       This is the fundamental dispatcher relationship.
    */

    if (
        !train.authority
    ) {

        train.targetSpeed =
            0;

        return;

    }


    train.targetSpeed =
        authorized;

}


/* ============================================================
   BRAKING DISTANCE
   ============================================================ */

function calculateBrakingDistance(
    speedMPH,
    targetMPH,
    brakingMPHPS
) {

    if (
        speedMPH <= targetMPH
    ) {

        return 0;

    }


    const speedDifference =
        speedMPH
        -
        targetMPH;


    /*
       Simplified kinematic estimate.

       Final model can incorporate train mass, grade,
       locomotive dynamics and brake-pipe propagation.
    */

    return (
        speedDifference
        *
        speedDifference
    )
    /
    (
        2
        *
        brakingMPHPS
        *
        3600
    );

}


/* ============================================================
   APPROACH SPEED RESTRICTION
   ============================================================ */

function prepareForRestriction(
    train
) {

    const restriction =
        getSpeedRestriction(
            train.position,
            train.direction
        );


    if (!restriction) {
        return;
    }


    if (
        train.speed
        <=
        restriction.speed
    ) {

        return;

    }


    /*
       The current implementation begins braking when the train
       reaches the restriction boundary.

       The later predictive braking model can begin braking
       before the boundary based on train length and braking rate.
    */

    train.targetSpeed =
        restriction.speed;


    train.braking =
        true;

}


/* ============================================================
   TRAIN ACCELERATION / BRAKING
   ============================================================ */

function updateTrainSpeed(
    train,
    deltaSeconds
) {

    updateTrainTargetSpeed(
        train
    );


    const target =
        train.targetSpeed;


    const type =
        TRAIN_TYPES[
            train.type
        ]
        ||
        TRAIN_TYPES.MANIFEST;


    const acceleration =
        type.acceleration;


    const braking =
        type.braking;


    /*
       ----------------------------------------------------------
       TRAIN IS TOO FAST
       ----------------------------------------------------------
    */

    if (
        train.speed
        >
        target
    ) {

        train.braking =
            true;


        train.accelerating =
            false;


        train.speed -=
            braking
            *
            deltaSeconds;


        train.speed =
            Math.max(
                target,
                train.speed
            );


    }


    /*
       ----------------------------------------------------------
       TRAIN IS TOO SLOW
       ----------------------------------------------------------
    */

    else if (
        train.speed
        <
        target
    ) {

        train.braking =
            false;


        train.accelerating =
            true;


        train.speed +=
            acceleration
            *
            deltaSeconds;


        train.speed =
            Math.min(
                target,
                train.speed
            );

    }


    /*
       ----------------------------------------------------------
       TRAIN AT TARGET
       ----------------------------------------------------------
    */

    else {

        train.braking =
            false;

        train.accelerating =
            false;

    }


    /*
       Prevent microscopic movement when stopped.
    */

    if (
        train.speed
        <
        TRAIN_PHYSICS.minimumMovementSpeed
    ) {

        train.speed = 0;

    }

}


/* ============================================================
   MOVE TRAIN
   ============================================================ */

function moveTrain(
    train,
    deltaSeconds
) {

    if (
        train.status
        !== TRAIN_STATUS.MOVING
        &&
        train.status
        !== TRAIN_STATUS.DEPARTING
        &&
        train.status
        !== TRAIN_STATUS.ARRIVING
    ) {

        return;

    }


    if (
        train.speed <= 0
    ) {

        train.status =
            TRAIN_STATUS.STOPPED;

        return;

    }


    /*
       Update speed first.
    */

    updateTrainSpeed(
        train,
        deltaSeconds
    );


    if (
        train.speed <= 0
    ) {

        train.status =
            TRAIN_STATUS.STOPPED;

        return;

    }


    /*
       MPH → miles/sec → miles traveled this frame.
    */

    const milesMoved =
        mphToMilesPerSecond(
            train.speed
        )
        *
        deltaSeconds;


    const previousPosition =
        train.position;


    if (
        train.direction === "east"
    ) {

        train.position -=
            milesMoved;

    }
    else {

        train.position +=
            milesMoved;

    }


    updateTrainRearPosition(
        train
    );


    /*
       Check railroad state after physical movement.
    */

    updateTrainBlock(
        train
    );


    checkSignalBoundary(
        train,
        previousPosition
    );


    checkSpeedRestrictions(
        train,
        previousPosition
    );


    checkDetectors(
        train,
        previousPosition
    );


    checkTrainLimits(
        train
    );


    checkCrewTime(
        train,
        deltaSeconds
    );

}


/* ============================================================
   TRAIN BLOCK DETECTION
   ============================================================ */

function updateTrainBlock(
    train
) {

    const block =
        findBlockAt(
            train.position,
            train.trackId
        );


    if (!block) {

        return;

    }


    if (
        train.currentBlockId
        === block.id
    ) {

        return;

    }


    const previousBlock =
        train.currentBlockId
            ? CP.territory.blocks
                .find(
                    b =>
                        b.id
                        ===
                        train.currentBlockId
                )
            : null;


    train.previousBlockId =
        train.currentBlockId;


    train.currentBlockId =
        block.id;


    /*
       Enter new block.
    */

    setBlockOccupancy(
        block,
        train.id
    );


    /*
       Clear previous block only when the ENTIRE TRAIN has
       cleared it.

       This is why train length matters.
    */

    if (
        previousBlock
    ) {

        if (
            trainHasClearedBlock(
                train,
                previousBlock
            )
        ) {

            clearBlockOccupancy(
                previousBlock,
                train.id
            );

        }

    }


    /*
       The ATCS visual update occurs here.

       It is a discrete state transition, not a smooth animation.
    */

    if (
        train.lastDisplayedBlockId
        !==
        block.id
    ) {

        train.lastDisplayedBlockId =
            block.id;


        updateATCSOccupancy(
            train
        );

    }

}


/* ============================================================
   HAS ENTIRE TRAIN CLEARED BLOCK?
   ============================================================ */

function trainHasClearedBlock(
    train,
    block
) {

    const high =
        Math.max(
            block.westMile,
            block.eastMile
        );


    const low =
        Math.min(
            block.westMile,
            block.eastMile
        );


    /*
       Eastbound rear is higher MP.
       Westbound rear is lower MP.
    */

    if (
        train.direction === "east"
    ) {

        return (
            train.rearPosition
            <
            low
        );

    }


    return (
        train.rearPosition
        >
        high
    );

}


/* ============================================================
   ATCS OCCUPANCY UPDATE
   ============================================================ */

function updateATCSOccupancy(
    train
) {

    /*
       Clear stale visual state from the train's previous block
       after the actual rear has cleared it.

       The display is section-based.
    */

    CP.territory.blocks
        .forEach(
            block => {

                if (
                    block.occupiedBy
                    !== train.id
                ) {
                    return;
                }


                renderBlockState(
                    block
                );

            }
        );

}


/* ============================================================
   SIGNAL BOUNDARY CHECK
   ============================================================ */

function checkSignalBoundary(
    train,
    previousPosition
) {

    const signals =
        CP.territory.signals
            .filter(
                signal =>
                    signal.trackId
                    ===
                    train.trackId
            );


    signals.forEach(
        signal => {

            const crossed =
                train.direction
                === "east"

                    ?

                    (
                        previousPosition
                        >
                        signal.milepost
                        &&
                        train.position
                        <=
                        signal.milepost
                    )

                    :

                    (
                        previousPosition
                        <
                        signal.milepost
                        &&
                        train.position
                        >=
                        signal.milepost
                    );


            if (!crossed) {
                return;
            }


            handleSignalPassed(
                train,
                signal
            );

        }
    );

}


/* ============================================================
   HANDLE SIGNAL PASSED
   ============================================================ */

function handleSignalPassed(
    train,
    signal
) {

    /*
       A train cannot legitimately pass a STOP signal.
       The engine stops it at the signal.

       This is also where signal-rule effects are recorded.
    */

    if (
        signal.indication
        === "STOP"
    ) {

        train.position =
            signal.milepost;


        train.speed =
            0;


        train.targetSpeed =
            0;


        train.authority =
            false;


        train.status =
            TRAIN_STATUS.STOPPED;


        train.stoppedAtSignal =
            signal.id;


        train.signalIndication =
            "STOP";


        radioLog(
            train.symbol
            + " stopped at "
            + signal.name
            + ". Signal STOP.",
            "alert"
        );


        return;

    }


    train.lastSignalPassed =
        signal.id;


    train.signalIndication =
        signal.indication;


    /*
       The train now receives the indication for the next
       portion of railroad.
    */

    updateTrainTargetSpeed(
        train
    );


    /*
       The dispatcher board itself doesn't need to animate the
       signal transition.

       It simply reflects the current railroad state.
    */

    radioLog(
        train.symbol
        + " passed "
        + signal.name
        + " — "
        + signal.indication,
        "crew"
    );

}


/* ============================================================
   SPEED RESTRICTION CHECK
   ============================================================ */

function checkSpeedRestrictions(
    train,
    previousPosition
) {

    const restrictions =
        CP.territory.speedRestrictions;


    restrictions.forEach(
        restriction => {

            const crossedBegin =
                crossedMilepost(
                    train,
                    previousPosition,
                    restriction.beginMile
                );


            if (
                crossedBegin
            ) {

                train.activeRestriction =
                    restriction;


                updateTrainTargetSpeed(
                    train
                );


                radioLog(
                    train.symbol
                    + " entering "
                    + restriction.speed
                    + " MPH restriction.",
                    "dispatcher"
                );

            }


            if (
                restriction.resumeMile
            ) {

                const crossedResume =
                    crossedMilepost(
                        train,
                        previousPosition,
                        restriction.resumeMile
                    );


                if (
                    crossedResume
                ) {

                    train.activeRestriction =
                        null;


                    updateTrainTargetSpeed(
                        train
                    );

                }

            }

        }
    );

}


/* ============================================================
   CROSSED MILEPOST
   ============================================================ */

function crossedMilepost(
    train,
    previousPosition,
    milepost
) {

    if (
        train.direction === "east"
    ) {

        return (
            previousPosition
            >
            milepost
            &&
            train.position
            <=
            milepost
        );

    }


    return (
        previousPosition
        <
        milepost
        &&
        train.position
        >=
        milepost
    );

}


/* ============================================================
   TRAIN LIMIT CHECK
   ============================================================ */

function checkTrainLimits(
    train
) {

    /*
       Eastbound Chicago Line example:
       eventually reaches lower mileposts toward Bellevue.

       Westbound moves toward higher mileposts.

       Final territory boundary logic will use actual dispatcher
       limits.
    */

    if (
        train.direction === "east"
        &&
        train.position <=
        TERRITORY_VIEW.eastMile
    ) {

        train.status =
            TRAIN_STATUS.COMPLETE;


        train.speed =
            0;


        radioLog(
            train.symbol
            + " reached modeled territory limit.",
            "dispatcher"
        );

    }


    if (
        train.direction === "west"
        &&
        train.position >=
        TERRITORY_VIEW.westMile
    ) {

        train.status =
            TRAIN_STATUS.COMPLETE;


        train.speed =
            0;


        radioLog(
            train.symbol
            + " reached modeled territory limit.",
            "dispatcher"
        );

    }

}


/* ============================================================
   CREW TIMER
   ============================================================ */

function checkCrewTime(
    train,
    deltaSeconds
) {

    if (
        train.status
        === TRAIN_STATUS.COMPLETE
    ) {

        return;

    }


    if (
        train.crewMinutes
        <= 0
    ) {

        return;

    }


    /*
       Convert real seconds into accelerated GAME minutes.

       3 game minutes per real minute.
    */

    train.crewMinutes -=
        (
            deltaSeconds
            /
            60
        )
        *
        CP.clock.multiplier;


    if (
        train.crewMinutes
        <= 0
    ) {

        train.crewMinutes =
            0;


        train.speed =
            0;


        train.targetSpeed =
            0;


        train.authority =
            false;


        train.status =
            TRAIN_STATUS.CREW_EXPIRED;


        radioLog(
            train.symbol
            + " crew time expired. Train stopped.",
            "alert"
        );


        notify(
            train.symbol
            + " CREW TIME EXPIRED",
            "red"
        );

    }

}


/* ============================================================
   TRAIN TAG CREATION
   ============================================================ */

function createTrainTag(
    train
) {

    const canvas =
        document.getElementById(
            "territoryCanvas"
        );


    const tag =
        document.createElement(
            "div"
        );


    tag.className =
        "trainTag "
        +
        (
            train.direction
            === "east"
                ? "eastbound"
                : "westbound"
        )
        +
        " "
        +
        (
            train.priority <= 2
                ? "priority"
                : ""
        );


    tag.dataset.trainId =
        train.id;


    tag.textContent =
        train.symbol;


    tag.addEventListener(
        "click",
        event => {

            event.stopPropagation();

            selectTrain(
                train.id
            );

        }
    );


    canvas.appendChild(
        tag
    );


    train.tagElement =
        tag;


    updateTrainTagPosition(
        train
    );

}


/* ============================================================
   UPDATE TRAIN TAG POSITION
   ============================================================ */

function updateTrainTagPosition(
    train
) {

    if (
        !train.tagElement
    ) {

        return;

    }


    const x =
        mileToPixel(
            train.position
        );


    let trackTop =
        100;


    switch (
        train.trackId
    ) {

        case "main-1":
            trackTop = 100;
            break;

        case "main-2":
            trackTop = 145;
            break;

        case "main-3":
            trackTop = 190;
            break;

        case "main-4":
            trackTop = 235;
            break;

        default:
            trackTop = 100;

    }


    train.tagElement.style.left =
        (
            x - 20
        )
        + "px";


    train.tagElement.style.top =
        (
            trackTop
            -
            9
        )
        + "px";


    train.tagElement.classList.toggle(
        "stopped",
        train.status
        !==
        TRAIN_STATUS.MOVING
        &&
        train.status
        !==
        TRAIN_STATUS.DEPARTING
    );


    train.tagElement.classList.toggle(
        "moving",
        train.status
        ===
        TRAIN_STATUS.MOVING
    );

}


/* ============================================================
   UPDATE ALL TRAIN TAGS
   ============================================================ */

function updateTrainTags() {

    CP.trains.forEach(
        train => {

            updateTrainTagPosition(
                train
            );

        }
    );

}


/* ============================================================
   REMOVE TRAIN
   ============================================================ */

function removeTrain(
    train
) {

    if (
        train.tagElement
    ) {

        train.tagElement.remove();

    }


    if (
        train.currentBlockId
    ) {

        const block =
            CP.territory.blocks
                .find(
                    b =>
                        b.id
                        ===
                        train.currentBlockId
                );


        if (block) {

            clearBlockOccupancy(
                block,
                train.id
            );

        }

    }


    CP.trains =
        CP.trains.filter(
            t =>
                t.id
                !==
                train.id
        );


    updateTrainList();

    updateTrafficDisplay();

}


/* ============================================================
   TRAIN PHYSICS UPDATE
   ============================================================ */

function updateAllTrains(
    deltaSeconds
) {

    CP.trains.forEach(
        train => {

            /*
               Skip completed trains.
            */

            if (
                train.status
                === TRAIN_STATUS.COMPLETE
            ) {

                return;

            }


            if (
                train.status
                === TRAIN_STATUS.CREW_EXPIRED
            ) {

                return;

            }


            moveTrain(
                train,
                deltaSeconds
            );


            updateTrainTagPosition(
                train
            );

        }
    );

}


/* ============================================================
   RADIO CALL FOUNDATION
   ============================================================ */

function initiateTrainRadioCall(
    train
) {

    if (!CP.radio.online) {

        return;

    }


    train.radioState =
        "CALLING";


    radioLog(
        train.symbol
        + " calling dispatcher.",
        "crew"
    );


    /*
       The actual voice/audio dialogue state machine is added
       separately so every train can maintain its own crew voice.
    */


    setTimeout(
        () => {

            if (
                train.radioState
                !== "CALLING"
            ) {

                return;

            }


            radioLog(
                train.symbol
                + ": dispatcher, "
                + train.symbol
                + " over.",
                "crew"
            );


            train.radioState =
                "WAITING_FOR_DISPATCHER";

        },
        650
    );

}


/* ============================================================
   AUTOMATIC SIGNAL AUTHORITY UPDATE
   ============================================================ */

function updateTrainSignalAuthority(
    train
) {

    /*
       Find the next signal in the train's direction.
    */

    const candidateSignals =
        CP.territory.signals
            .filter(
                signal => {

                    if (
                        signal.trackId
                        !==
                        train.trackId
                    ) {

                        return false;

                    }


                    if (
                        signal.direction
                        !==
                        train.direction
                    ) {

                        return false;

                    }


                    if (
                        train.direction
                        ===
                        "east"
                    ) {

                        return (
                            signal.milepost
                            <
                            train.position
                        );

                    }


                    return (
                        signal.milepost
                        >
                        train.position
                    );

                }
            );


    if (
        candidateSignals.length
        ===
        0
    ) {

        return;

    }


    candidateSignals.sort(
        (a, b) => {

            if (
                train.direction
                ===
                "east"
            ) {

                return (
                    b.milepost
                    -
                    a.milepost
                );

            }


            return (
                a.milepost
                -
                b.milepost
            );

        }
    );


    const nextSignal =
        candidateSignals[0];


    train.signalIndication =
        nextSignal.indication;


    /*
       If the signal is STOP, the train does not have authority
       beyond that signal.

       If it is cleared, authority exists to the route limit.
    */

    if (
        nextSignal.indication
        ===
        "STOP"
    ) {

        /*
           A train may still be moving toward a stop signal.
           Authority ends at the signal.
        */

        return;

    }


    train.authority =
        true;

}


/* ============================================================
   EXTEND MAIN SIMULATION TICK
   ============================================================ */

const previousSimulationTickPart4 =
    simulationTick;


simulationTick =
    function(deltaSeconds) {

        /*
           Run all previous simulation systems.
        */

        previousSimulationTickPart4(
            deltaSeconds
        );


        /*
           Update signal authority.
        */

        CP.trains.forEach(
            train => {

                updateTrainSignalAuthority(
                    train
                );

            }
        );


        /*
           Physical train movement.
        */

        updateAllTrains(
            deltaSeconds
        );


        /*
           Update tags after movement.
        */

        updateTrainTags();


        /*
           Re-evaluate interlocking after train movement.
        */

        updateInterlocking();

    };


