       This is intentionally independent of the old temporary
       territory viewport.

       We will replace the numerical anchors with verified
       territory data as the actual railroad is built.
    */

    westMP: 507,

    eastMP: 402,

    pixelsPerMile: 68,

    mileToX(mp) {

        return (
            (this.westMP - Number(mp)) *
            this.pixelsPerMile
        ) + 80;
    },

    xToMile(x) {

        return this.westMP -
            ((Number(x) - 80) /
            this.pixelsPerMile);
    }
};


