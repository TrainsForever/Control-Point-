/* ============================================================
   5.22 BOARD CLICK INTERACTION
   ============================================================ */

function installDispatcherBoardInteraction() {

    /*
       The game may use a canvas, SVG, or HTML track elements.

       We listen globally and only react to objects explicitly
       tagged by the renderer.
    */

    document.addEventListener("click", event => {

        const target =
            event.target.closest
                ? event.target.closest(
                    "[data-cp-control-point]," +
                    "[data-cp-signal]," +
                    "[data-cp-switch]," +
                    "[data-cp-train]"
                )
                : null;

        if (!target) return;

        /*
           CONTROL POINT
        */

        if (target.dataset.cpControlPoint) {

            openControlPointRoutes(
                target.dataset.cpControlPoint
            );

            return;
        }

        /*
           SIGNAL
        */

        if (target.dataset.cpSignal) {

            const signalId =
                target.dataset.cpSignal;

            let signal = null;

            try {

                if (
                    typeof SIGNALS !== "undefined" &&
                    Array.isArray(SIGNALS)
                ) {

                    signal =
                        SIGNALS.find(
                            s => s.id === signalId
                        );
                }

            } catch (e) {}

            if (!signal) {
                signal = {
                    id: signalId
                };
            }

            selectDispatcherSignal(signal);

            return;
        }

        /*
           SWITCH
        */

        if (target.dataset.cpSwitch) {

            const switchId =
                target.dataset.cpSwitch;

            let switchObj = null;

            try {

                if (
                    typeof SWITCHES !== "undefined" &&
                    Array.isArray(SWITCHES)
                ) {

                    switchObj =
                        SWITCHES.find(
                            s => s.id === switchId
                        );
                }

            } catch (e) {}

            if (!switchObj) {
                switchObj = {
                    id: switchId
                };
            }

            selectDispatcherSwitch(switchObj);

            return;
        }

        /*
           TRAIN
        */

        if (target.dataset.cpTrain) {

            const trainId =
                target.dataset.cpTrain;

            let train = null;

            try {

                if (
                    typeof CP !== "undefined" &&
                    Array.isArray(CP.trains)
                ) {

                    train =
                        CP.trains.find(
                            t =>
                                t.id === trainId ||
                                t.symbol === trainId
                        );
                }

            } catch (e) {}

            if (train) {
                selectDispatcherTrain(train);
            }
        }
    });
}


