/* ============================================================
   CONTROL POINT
   PART 7 — RADIO + DISPATCHER CONVERSATION SYSTEM
   ============================================================ */

/*
   RADIO PHILOSOPHY
   -----------------

   Trains initiate radio traffic.

   The dispatcher does NOT automatically answer.

   The player must answer the train.

   Example:

       35J Chicago, over.

       [ANSWER 35J]

       Chicago answering, over.

       35J crew is on board, ready to depart, over.

       [ANSWER 35J]

       Dispatcher receives control choices.

       [WAIT FOR ONE]
       [WAIT FOR TWO]
       [HOLD]
       [SIGNAL INDICATION]

   The train only moves when the dispatcher has provided
   appropriate authority.

   This system is event/state driven.
*/


/* ============================================================
   7.1 RADIO SYSTEM STATE
   ============================================================ */

CP.radio = CP.radio || {};

Object.assign(CP.radio, {

    activeCalls: {},

    pendingCalls: [],

    completedCalls: [],

    assignedVoices: {},

    callCounter: 0,

    lastCallTime: 0,

    responseCooldown: 900,

    conversationTimeout: 30000
});


/* ============================================================
   7.2 RADIO VOICE ASSIGNMENT
   ============================================================ */

function assignCrewVoice(train) {

    if (!train) {
        return null;
    }

    const trainId =
        train.id ||
        train.symbol ||
        ("TRAIN-" + Math.random());

    /*
       Once a voice is assigned to a train, it stays with
       that train for the remainder of the run.
    */

    if (
        CP.radio.assignedVoices[trainId]
    ) {

        return CP.radio.assignedVoices[trainId];
    }

    let voices = [];

    if (
        typeof CREW_VOICES !== "undefined" &&
        Array.isArray(CREW_VOICES)
    ) {

        voices =
            CREW_VOICES;
    }

    if (!voices.length) {

        voices = [
            "CREW-01",
            "CREW-02",
            "CREW-03",
            "CREW-04",
            "CREW-05"
        ];
    }

    const voice =
        voices[
            Math.floor(
                Math.random() *
                voices.length
            )
        ];

    CP.radio.assignedVoices[
        trainId
    ] = voice;

    train.crewVoice =
        voice;

    return voice;
}


/* ============================================================
   7.3 TRAIN RADIO ID
   ============================================================ */

function getTrainRadioID(train) {

    if (!train) {
        return "UNKNOWN";
    }

    return (
        train.id ||
        train.symbol ||
        train.name ||
        "UNKNOWN"
    );
}


/* ============================================================
   7.4 DISPATCHER TERRITORY
   ============================================================ */

const DISPATCHER_TERRITORIES = [

    {
        id: "CHICAGO",

        name: "Chicago",

        /*
           Chicago-end territory.
           Final exact boundaries will be tied to verified
           territory infrastructure later.
        */

        westMP: 507,

        eastMP: 421.5
    },

    {
        id: "ELKHART",

        name: "Elkhart",

        westMP: 421.5,

        eastMP: 402
    }
];


/* ============================================================
   7.5 GET DISPATCHER FOR TRAIN
   ============================================================ */

function getTrainDispatcher(train) {

    if (!train) {
        return null;
    }

    /*
       Explicit dispatcher assignment wins.
    */

    if (train.dispatcherTerritory) {

        const explicit =
            DISPATCHER_TERRITORIES.find(
                territory =>
                    territory.id ===
                    train.dispatcherTerritory
            );

        if (explicit) {
            return explicit;
        }
    }

    const mp =
        Number(train.mp);

    if (!Number.isFinite(mp)) {

        return DISPATCHER_TERRITORIES[0];
    }

    /*
       Chicago territory.
    */

    if (
        mp <= 507 &&
        mp >= 421.5
    ) {

        return DISPATCHER_TERRITORIES[0];
    }

    /*
       Elkhart-side territory.

       NOTE:
       This boundary is an engine placeholder until the final
       verified territory handoff is loaded.
    */

    if (
        mp < 421.5 &&
        mp >= 402
    ) {

        return DISPATCHER_TERRITORIES[1];
    }

    return DISPATCHER_TERRITORIES[0];
}


/* ============================================================
   7.6 TRAIN RADIO STATE
   ============================================================ */

function initializeTrainRadio(train) {

    if (!train) {
        return;
    }

    const id =
        getTrainRadioID(train);

    assignCrewVoice(train);

    if (!train.radioState) {

        train.radioState = {

            state: "QUIET",

            dispatcher:
                getTrainDispatcher(train),

            waitingFor:
                [],

            holdReason:
                null,

            readyToDepart:
                false,

            signalReceived:
                false,

            lastCall:
                0,

            callAnswered:
                false,

            conversation:
                []
        };
    }

    /*
       Dispatcher territory can change as the train moves.
    */

    train.radioState.dispatcher =
        getTrainDispatcher(train);
}


/* ============================================================
   7.7 RADIO MESSAGE OBJECT
   ============================================================ */

function createRadioMessage(
    train,
    speaker,
    text,
    type = "crew"
) {

    return {

        id:
            ++CP.radio.callCounter,

        train:
            getTrainRadioID(train),

        speaker,

        text,

        type,

        time:
            Date.now()
    };
}


/* ============================================================
   7.8 RADIO DISPLAY
   ============================================================ */

function displayRadioMessage(message) {

    if (!message) {
        return;
    }

