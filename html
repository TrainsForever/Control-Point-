<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>CONTROL POINT</title>

<style>
/* ============================================================
   CONTROL POINT
   PART 1
   ATCS-STYLE DISPATCHER INTERFACE
   ============================================================ */

:root {
    --bg: #050505;
    --panel: #0a0a0a;
    --panel-2: #0e0e0e;
    --border: #242424;

    --white: #eeeeee;
    --dim-white: #a7a7a7;
    --gray: #666666;

    --red: #ff2020;
    --green: #00ff48;
    --yellow: #ffe900;
    --blue: #3aa8ff;
    --orange: #ff9b21;

    --signal-red: #ff1818;
    --signal-green: #00ff3c;
    --signal-yellow: #ffe600;

    --font-main: Arial, Helvetica, sans-serif;
    --font-mono: "Courier New", Courier, monospace;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--white);
    font-family: var(--font-main);
}

body {
    display: flex;
    flex-direction: column;
}

/* ============================================================
   TOP SYSTEM BAR
   ============================================================ */

#topBar {
    height: 42px;
    min-height: 42px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 10px;

    background: #080808;
    border-bottom: 1px solid #303030;

    font-family: var(--font-mono);
    font-size: 12px;

    z-index: 100;
}

#gameTitle {
    display: flex;
    align-items: center;
    gap: 9px;

    white-space: nowrap;
}

#gameTitle .cpMark {
    width: 7px;
    height: 22px;
    background: var(--green);
}

#gameTitle strong {
    color: #ffffff;
    letter-spacing: 2px;
    font-size: 13px;
}

#gameTitle span {
    color: #777777;
    letter-spacing: 1px;
}

#systemStatus {
    display: flex;
    align-items: center;
    gap: 15px;

    color: #999999;
}

.statusItem {
    white-space: nowrap;
}

.statusValue {
    color: #ffffff;
}

.statusValue.green {
    color: var(--green);
}

.statusValue.red {
    color: var(--red);
}

.statusValue.yellow {
    color: var(--yellow);
}

/* ============================================================
   MAIN APPLICATION
   ============================================================ */

#app {
    flex: 1;

    min-height: 0;

    display: flex;
    flex-direction: column;

    background: #050505;
}

/* ============================================================
   DISPATCHER CONTROL STRIP
   ============================================================ */

#controlStrip {
    height: 38px;
    min-height: 38px;

    display: flex;
    align-items: center;
    gap: 5px;

    padding: 4px 7px;

    background: #090909;
    border-bottom: 1px solid #292929;

    overflow-x: auto;
    overflow-y: hidden;

    scrollbar-width: none;
}

#controlStrip::-webkit-scrollbar {
    display: none;
}

.controlButton {
    height: 29px;

    flex: 0 0 auto;

    padding: 0 10px;

    border: 1px solid #393939;
    border-radius: 2px;

    background: #111111;
    color: #cfcfcf;

    font-family: var(--font-mono);
    font-size: 11px;

    cursor: pointer;

    user-select: none;
}

.controlButton:hover {
    background: #181818;
    color: #ffffff;
}

.controlButton:active {
    background: #222222;
}

.controlButton.active {
    border-color: #777777;
    color: #ffffff;
}

.controlButton.dispatch {
    border-color: #005f20;
    color: var(--green);
}

.controlButton.warning {
    border-color: #6c6100;
    color: var(--yellow);
}

.controlButton.danger {
    border-color: #6b0000;
    color: var(--red);
}

.controlDivider {
    width: 1px;
    height: 22px;
    background: #333333;
    margin: 0 3px;
}

/* ============================================================
   TERRITORY VIEWPORT
   ============================================================ */

#territoryViewport {
    position: relative;

    flex: 1;

    min-height: 0;

    overflow: auto;

    background:
        linear-gradient(
            to bottom,
            rgba(255,255,255,0.015),
            rgba(255,255,255,0.0)
        ),
        #030303;

    scrollbar-color: #3c3c3c #090909;
    scrollbar-width: thin;
}

#territoryCanvas {
    position: relative;

    width: 6500px;
    min-width: 6500px;

    height: 100%;

    min-height: 650px;
}

/* ============================================================
   TERRITORY HEADER
   ============================================================ */

.territoryHeader {
    position: absolute;

    top: 8px;
    left: 20px;

    height: 24px;

    display: flex;
    align-items: center;
    gap: 16px;

    font-family: var(--font-mono);
    font-size: 11px;

    pointer-events: none;

    z-index: 10;
}

.territoryName {
    color: #eeeeee;
    letter-spacing: 1px;
}

.territoryDirection {
    color: #777777;
}

.territoryMileRange {
    color: #555555;
}

/* ============================================================
   TRACK ROWS
   ============================================================ */

.trackRow {
    position: absolute;

    left: 0;

    width: 100%;
    height: 34px;
}

.trackLabel {
    position: absolute;

    left: 10px;

    top: 50%;
    transform: translateY(-50%);

    width: 28px;

    color: #666666;

    font-family: var(--font-mono);
    font-size: 9px;

    text-align: right;

    pointer-events: none;
}

.trackLine {
    position: absolute;

    left: 55px;
    right: 15px;

    top: 16px;

    height: 1px;

    background: var(--white);

    transition: none;

    cursor: crosshair;
}

.trackLine.occupied {
    background: var(--red);
}

.trackLine.lined {
    background: var(--green);
}

.trackLine.protected {
    background: var(--green);
}

.trackLine.trackTime {
    background: var(--blue);
}

.trackLine.stored {
    background: var(--orange);
}

/*
   IMPORTANT:
   There are NO smooth color animations on track lines.

   Real ATCS-style state changes are discrete.
   A block/route changes state abruptly.
*/

.trackBlock {
    position: absolute;

    top: 5px;
    height: 23px;

    background: transparent;

    cursor: pointer;
}

/* ============================================================
   BLOCK BOUNDARIES
   ============================================================ */

.blockBoundary {
    position: absolute;

    top: 5px;

    width: 1px;
    height: 23px;

    background: #303030;

    pointer-events: none;
}

.blockBoundary.signalBoundary {
    background: #555555;
}

/* ============================================================
   SIGNALS
   ============================================================ */

.signal {
    position: absolute;

    top: 2px;

    width: 18px;
    height: 28px;

    display: flex;
    flex-direction: column;
    align-items: center;

    cursor: pointer;

    z-index: 20;
}

.signalMast {
    position: absolute;

    left: 8px;
    top: 3px;

    width: 1px;
    height: 24px;

    background: #888888;
}

.signalHeads {
    position: absolute;

    left: 3px;
    top: 1px;

    display: flex;
    flex-direction: column;

    gap: 2px;

    z-index: 2;
}

.signalHead {
    width: 10px;
    height: 6px;

    border-radius: 50%;

    border: 1px solid #383838;

    background: #090909;
}

.signalHead.red {
    background: var(--signal-red);
    border-color: #ff5050;
}

.signalHead.green {
    background: var(--signal-green);
    border-color: #61ff91;
}

.signalHead.yellow {
    background: var(--signal-yellow);
    border-color: #fff47b;
}

.signalLabel {
    position: absolute;

    top: 29px;
    left: 50%;

    transform: translateX(-50%);

    color: #aaaaaa;

    font-family: var(--font-mono);
    font-size: 8px;

    white-space: nowrap;

    pointer-events: none;
}

.signal:hover .signalLabel {
    color: #ffffff;
}

/* ============================================================
   SWITCHES
   ============================================================ */

.switch {
    position: absolute;

    width: 22px;
    height: 18px;

    cursor: pointer;

    z-index: 25;
}

.switchMain {
    position: absolute;

    left: 0;
    top: 9px;

    width: 22px;
    height: 1px;

    background: #eeeeee;
}

.switchPoint {
    position: absolute;

    left: 5px;
    top: 4px;

    width: 15px;
    height: 1px;

    background: #eeeeee;

    transform-origin: left center;
}

.switch.normal .switchPoint {
    transform: rotate(0deg);
}

.switch.reverse .switchPoint {
    transform: rotate(24deg);
}

.switchIndicator {
    position: absolute;

    right: -6px;
    top: 4px;

    width: 4px;
    height: 4px;

    border: 1px solid #777777;

    background: #111111;
}

.switch.reverse .switchIndicator {
    background: var(--green);
}

/* ============================================================
   CONTROL POINT LABELS
   ============================================================ */

.controlPoint {
    position: absolute;

    top: 39px;

    transform: translateX(-50%);

    color: var(--red);

    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: bold;

    white-space: nowrap;

    z-index: 30;

    pointer-events: none;
}

.controlPoint .cpMile {
    display: block;

    margin-top: 2px;

    color: #777777;

    font-size: 8px;
    font-weight: normal;
}

/* ============================================================
   TOWN LABELS
   ============================================================ */

.townLabel {
    position: absolute;

    top: 10px;

    transform: translateX(-50%);

    color: #777777;

    font-family: var(--font-mono);
    font-size: 10px;

    white-space: nowrap;

    pointer-events: none;
}

.townLabel .townMile {
    color: #4e4e4e;
    font-size: 8px;
}

/* ============================================================
   SPEED RESTRICTIONS
   ============================================================ */

.speedRestriction {
    position: absolute;

    top: 53px;

    transform: translateX(-50%);

    color: var(--yellow);

    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: bold;

    white-space: nowrap;

    pointer-events: none;

    z-index: 32;
}

.speedRestriction .speedUnit {
    color: #777777;
    font-size: 7px;
    margin-left: 2px;
}

/*
   Physical curves, bridges, etc. do not have to be drawn
   on the ATCS schematic.

   The restriction can simply appear beside the track.
*/

/* ============================================================
   SIDINGS
   ============================================================ */

.sidingLabel {
    position: absolute;

    color: #555555;

    font-family: var(--font-mono);
    font-size: 8px;

    white-space: nowrap;

    pointer-events: none;
}

/* ============================================================
   DETECTORS
   ============================================================ */

.detector {
    position: absolute;

    top: -2px;

    width: 12px;
    height: 12px;

    border: 1px solid #777777;

    background: #080808;

    transform: rotate(45deg);

    cursor: pointer;

    z-index: 28;
}

.detector.active {
    border-color: var(--yellow);
    background: #222000;
}

.detectorLabel {
    position: absolute;

    top: 15px;
    left: 50%;

    transform: translateX(-50%);

    color: #777777;

    font-family: var(--font-mono);
    font-size: 7px;

    white-space: nowrap;

    pointer-events: none;
}

/* ============================================================
   TRAIN TAGS
   ============================================================ */

.trainTag {
    position: absolute;

    height: 17px;

    min-width: 42px;

    padding: 1px 4px;

    background: #050505;

    border: 1px solid #555555;

    color: #ffffff;

    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: bold;

    line-height: 13px;

    white-space: nowrap;

    z-index: 50;

    cursor: pointer;
}

.trainTag.eastbound {
    border-color: #888888;
}

.trainTag.westbound {
    border-color: #555555;
}

.trainTag.priority {
    color: var(--yellow);
}

.trainTag.stopped {
    color: var(--red);
}

.trainTag.moving {
    color: #ffffff;
}

/* ============================================================
   MILEPOST RULER
   ============================================================ */

.milepostRuler {
    position: absolute;

    bottom: 8px;

    height: 22px;

    left: 55px;
    right: 15px;

    border-top: 1px solid #292929;

    pointer-events: none;
}

.mileTick {
    position: absolute;

    top: 0;

    width: 1px;
    height: 6px;

    background: #555555;
}

.mileTickLabel {
    position: absolute;

    top: 7px;

    transform: translateX(-50%);

    color: #555555;

    font-family: var(--font-mono);
    font-size: 7px;

    white-space: nowrap;
}

/* ============================================================
   LOWER DISPATCHER PANEL
   ============================================================ */

#lowerPanel {
    height: 150px;
    min-height: 150px;

    display: grid;

    grid-template-columns: 1.2fr 1fr 0.9fr;

    background: #070707;

    border-top: 1px solid #303030;

    z-index: 80;
}

.lowerSection {
    min-width: 0;

    border-right: 1px solid #242424;

    overflow: hidden;
}

.lowerSection:last-child {
    border-right: none;
}

.sectionTitle {
    height: 25px;

    display: flex;
    align-items: center;

    padding: 0 8px;

    border-bottom: 1px solid #222222;

    color: #777777;

    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1px;
}

.sectionContent {
    height: calc(100% - 25px);

    overflow: auto;

    padding: 5px 7px;

    scrollbar-width: thin;
}

/* ============================================================
   TRAIN LIST
   ============================================================ */

.trainListRow {
    height: 20px;

    display: grid;

    grid-template-columns: 55px 1fr 45px 45px;

    align-items: center;

    padding: 0 4px;

    border-bottom: 1px solid #151515;

    font-family: var(--font-mono);
    font-size: 9px;
}

.trainListRow:hover {
    background: #101010;
}

.trainSymbol {
    color: #ffffff;
    font-weight: bold;
}

.trainDestination {
    color: #777777;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.trainSpeed {
    color: var(--white);
    text-align: right;
}

.trainState {
    text-align: right;
    color: #777777;
}

.trainState.moving {
    color: var(--green);
}

.trainState.stopped {
    color: var(--red);
}

.trainState.waiting {
    color: var(--yellow);
}

/* ============================================================
   RADIO LOG
   ============================================================ */

.radioEntry {
    display: grid;

    grid-template-columns: 52px 1fr;

    gap: 6px;

    margin-bottom: 3px;

    font-family: var(--font-mono);
    font-size: 9px;

    line-height: 13px;
}

.radioTime {
    color: #555555;
}

.radioText {
    color: #bcbcbc;
}

.radioText.crew {
    color: #ffffff;
}

.radioText.dispatcher {
    color: var(--green);
}

.radioText.detector {
    color: var(--yellow);
}

.radioText.alert {
    color: var(--red);
}

/* ============================================================
   SELECTED TRAIN / DISPATCHER INFO
   ============================================================ */

.infoGrid {
    display: grid;

    grid-template-columns: 72px 1fr;

    gap: 2px 7px;

    font-family: var(--font-mono);
    font-size: 9px;
}

.infoLabel {
    color: #555555;
}

.infoValue {
    color: #dddddd;
}

.infoValue.green {
    color: var(--green);
}

.infoValue.red {
    color: var(--red);
}

.infoValue.yellow {
    color: var(--yellow);
}

/* ============================================================
   MOBILE ADAPTATION
   ============================================================ */

@media (max-width: 800px) {

    #topBar {
        height: 38px;
        min-height: 38px;
    }

    #systemStatus {
        gap: 7px;
        font-size: 9px;
    }

    #gameTitle span {
        display: none;
    }

    #lowerPanel {
        height: 170px;
        min-height: 170px;

        grid-template-columns: 1fr;
    }

    .lowerSection {
        display: none;
    }

    .lowerSection:first-child {
        display: block;
        border-right: none;
    }

    #territoryCanvas {
        min-height: 600px;
    }
}

@media (max-height: 650px) {

    #lowerPanel {
        height: 125px;
        min-height: 125px;
    }
}

/* ============================================================
   DISPATCHER DIALOG / ROUTE POPUP
   ============================================================ */

#routePopup {
    position: fixed;

    display: none;

    min-width: 210px;

    background: #080808;

    border: 1px solid #555555;

    box-shadow: 0 5px 25px rgba(0,0,0,0.7);

    z-index: 500;
}

#routePopup.visible {
    display: block;
}

.popupHeader {
    height: 27px;

    display: flex;
    align-items: center;

    padding: 0 8px;

    background: #101010;

    border-bottom: 1px solid #333333;

    color: #dddddd;

    font-family: var(--font-mono);
    font-size: 10px;
}

.popupBody {
    padding: 7px;
}

.popupButton {
    width: 100%;

    height: 28px;

    margin-bottom: 5px;

    border: 1px solid #393939;

    background: #111111;

    color: #dddddd;

    font-family: var(--font-mono);
    font-size: 9px;

    cursor: pointer;
}

.popupButton:last-child {
    margin-bottom: 0;
}

.popupButton:hover {
    background: #1b1b1b;
}

.popupButton.clearRoute {
    color: var(--green);
}

.popupButton.stopRoute {
    color: var(--red);
}

/* ============================================================
   NOTIFICATION
   ============================================================ */

#notification {
    position: fixed;

    left: 50%;
    bottom: 175px;

    transform: translateX(-50%);

    display: none;

    max-width: 90vw;

    padding: 8px 14px;

    background: #090909;

    border: 1px solid #444444;

    color: #dddddd;

    font-family: var(--font-mono);
    font-size: 10px;

    z-index: 600;
}

#notification.visible {
    display: block;
}

#notification.green {
    border-color: #006b25;
    color: var(--green);
}

#notification.red {
    border-color: #6b0000;
    color: var(--red);
}

#notification.yellow {
    border-color: #665e00;
    color: var(--yellow);
}

/* ============================================================
   NO DECORATIVE GAME HUD
   ============================================================ */

/*
   CONTROL POINT intentionally does not use:
   - giant minimaps
   - floating mission markers
   - cartoon trains
   - GPS roads
   - giant speedometers
   - XP bars
   - mission banners
   - unnecessary animations

   The railroad board is the primary interface.
*/

</style>
</head>

<body>

<!-- ============================================================
     TOP SYSTEM BAR
     ============================================================ -->

<header id="topBar">

    <div id="gameTitle">

        <div class="cpMark"></div>

        <strong>CONTROL POINT</strong>

        <span>NS DISPATCH</span>

    </div>

    <div id="systemStatus">

        <div class="statusItem">
            TIME
            <span id="clockDisplay" class="statusValue">00:00</span>
        </div>

        <div class="statusItem">
            DAY
            <span id="dayDisplay" class="statusValue">1</span>
        </div>

        <div class="statusItem">
            TRAFFIC
            <span id="trafficDisplay" class="statusValue green">NORMAL</span>
        </div>

        <div class="statusItem">
            RADIO
            <span id="radioStatus" class="statusValue green">ONLINE</span>
        </div>

    </div>

</header>


<!-- ============================================================
     APPLICATION
     ============================================================ -->

<main id="app">


    <!-- ========================================================
         DISPATCHER CONTROL STRIP
         ======================================================== -->

    <div id="controlStrip">

        <button class="controlButton dispatch" id="pauseButton">
            PAUSE
        </button>

        <button class="controlButton" id="clockButton">
            3× CLOCK
        </button>

        <div class="controlDivider"></div>

        <button class="controlButton" id="trafficButton">
            TRAFFIC
        </button>

        <button class="controlButton" id="radioButton">
            RADIO
        </button>

        <button class="controlButton" id="trainsButton">
            TRAINS
        </button>

        <div class="controlDivider"></div>

        <button class="controlButton" id="westButton">
            ◀ WEST
        </button>

        <button class="controlButton" id="eastButton">
            EAST ▶
        </button>

        <div class="controlDivider"></div>

        <button class="controlButton warning" id="releaseRoutesButton">
            RELEASE ROUTES
        </button>

        <button class="controlButton danger" id="emergencyButton">
            EMERGENCY
        </button>

    </div>


    <!-- ========================================================
         TERRITORY
         ======================================================== -->

    <section id="territoryViewport">

        <div id="territoryCanvas">


            <!-- =================================================
                 TERRITORY HEADER
                 ================================================= -->

            <div class="territoryHeader">

                <span class="territoryName">
                    NORFOLK SOUTHERN — CHICAGO LINE
                </span>

                <span class="territoryDirection">
                    WEST ←──────────── EAST ────────────→
                </span>

                <span class="territoryMileRange">
                    CHICAGO / CP 502 — ELKHART — BELLEVUE
                </span>

            </div>


            <!-- =================================================
                 TRACK ROW 1
                 ================================================= -->

            <div class="trackRow" id="trackRow1" style="top:100px;">

                <div class="trackLabel">
                    1
                </div>

                <div
                    class="trackLine"
                    id="track-1"
                    data-track="1"
                    data-direction="east"
                ></div>

            </div>


            <!-- =================================================
                 TRACK ROW 2
                 ================================================= -->

            <div class="trackRow" id="trackRow2" style="top:145px;">

                <div class="trackLabel">
                    2
                </div>

                <div
                    class="trackLine"
                    id="track-2"
                    data-track="2"
                    data-direction="west"
                ></div>

            </div>


            <!-- =================================================
                 TRACK ROW 3
                 ================================================= -->

            <div class="trackRow" id="trackRow3" style="top:190px;">

                <div class="trackLabel">
                    3
                </div>

                <div
                    class="trackLine"
                    id="track-3"
                    data-track="3"
                    data-direction="east"
                ></div>

            </div>


            <!-- =================================================
                 TRACK ROW 4
                 ================================================= -->

            <div class="trackRow" id="trackRow4" style="top:235px;">

                <div class="trackLabel">
                    4
                </div>

                <div
                    class="trackLine"
                    id="track-4"
                    data-track="4"
                    data-direction="west"
                ></div>

            </div>


            <!-- =================================================
                 SIDING / AUXILIARY ROW
                 ================================================= -->

            <div class="trackRow" id="trackRowSiding" style="top:280px;">

                <div class="trackLabel">
                    S
                </div>

                <div
                    class="trackLine"
                    id="track-siding"
                    data-track="siding"
                ></div>

            </div>


