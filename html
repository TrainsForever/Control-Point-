/* ============================================================
   7.22 FIND CONFLICTING TRAINS
   ============================================================ */

function getCandidateConflictingTrains(
    train
) {

    if (
        typeof CP === "undefined" ||
        !Array.isArray(CP.trains)
    ) {

        return [];
    }

    const trainMP =
        Number(train.mp);

    const direction =
        String(
            train.direction ||
            ""
        ).toUpperCase();

    const candidates =
        CP.trains.filter(
            other => {

                if (
                    !other ||
                    other === train
                ) {
                    return false;
                }

                const otherMP =
                    Number(other.mp);

                if (
                    !Number.isFinite(
                        otherMP
                    ) ||
                    !Number.isFinite(
                        trainMP
                    )
                ) {
                    return false;
                }

                /*
                   Same dispatcher territory.
                */

                const dispatcherA =
                    getTrainDispatcher(
                        train
                    );

                const dispatcherB =
                    getTrainDispatcher(
                        other
                    );

                if (
                    dispatcherA &&
                    dispatcherB &&
                    dispatcherA.id !==
                    dispatcherB.id
                ) {

                    return false;
                }

                /*
                   Nearby traffic is most relevant.

                   This is a dispatching candidate list, not
                   the final route-conflict engine.
                */

                const distance =
                    Math.abs(
                        trainMP -
                        otherMP
                    );

                if (
                    distance > 15
                ) {

                    return false;
                }

                return true;
            }
        );

    /*
       Closest first.
    */

    candidates.sort(
        (
            a,
            b
        ) =>
            Math.abs(
                Number(a.mp) -
                trainMP
            ) -
            Math.abs(
                Number(b.mp) -
                trainMP
            )
    );

    return candidates;
}


/* ============================================================
   7.23 WAITING TRAIN UPDATE
   ============================================================ */

function updateTrainRadioWaiting(
    train
) {

    if (!train || !train.radioState) {
        return;
    }

    if (
        train.radioState.state !==
        "WAITING_FOR_TRAINS"
    ) {

        return;
    }

    const required =
        Number(
            train.radioState.waitCount ||
            0
        );

    if (
        required <= 0
    ) {

        return;
    }

    /*
       Remove trains that have cleared the relevant area.
    */

    train.radioState.waitingFor =
        train.radioState.waitingFor
            .filter(
                waitingId => {

                    const waitingTrain =
                        CP.trains.find(
                            other =>
                                getTrainRadioID(
                                    other
                                ) ===
                                waitingId
                        );

                    if (!waitingTrain) {
                        return false;
                    }

                    /*
                       A train is considered clear when it is
                       sufficiently separated from the waiting
                       train.
                    */

                    const distance =
                        Math.abs(
                            Number(
                                waitingTrain.mp
                            ) -
                            Number(
                                train.mp
                            )
                        );

                    return distance < 3;
                }
            );

    /*
       Once the required number of trains have cleared,
       notify the dispatcher.
    */

    if (
        train.radioState.waitingFor.length ===
        0
    ) {

        train.radioState.state =
            "CREW_READY";

        train.radioState.waitingFor =
            [];

        train.radioState.waitCount =
            0;

        train.radioState.signalReceived =
            false;

        dispatcherEvent(
            `${getTrainRadioID(train)} — HOLDING CONDITION CLEARED`
        );

        /*
           Crew calls dispatcher again.
        */

        setTimeout(
            () => {

                crewRadio(
                    train,
                    `${getTrainRadioID(train)} ready for signal indication, over.`
                );

                createDispatcherResponsePanel(
                    train
                );

            },
            500
        );
    }
}


