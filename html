/* ============================================================
   6.24 ATCS BOARD SCROLL POSITION
   ============================================================ */

function scrollATCSToMilepost(mp) {

    const board =
        getATCSBoard();

    if (!board) {
        return;
    }

    const x =
        ATCS_SCALE.mileToX(
            mp
        );

    board.scrollLeft =
        Math.max(
            0,
            x - (
                board.clientWidth / 2
            )
        );
}


/* ============================================================
   6.25 DOUBLE CLICK NAVIGATION
   ============================================================ */

const atcsBoard =
    getATCSBoard();

atcsBoard.addEventListener(
    "dblclick",
    event => {

        /*
           Convert the screen position into territory MP.

           This is useful for quickly navigating the board
           during development.
