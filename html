function drawATCSLocations(ctx) {

    ctx.save();

    ctx.textAlign =
        "center";

    ctx.textBaseline =
        "top";

    for (
        const location
        of ATCS_LOCATIONS
    ) {

        const x =
            ATCS_SCALE.mileToX(
                location.mp
            );

        /*
           Keep location labels compact.
        */

        ctx.font =
            location.type === "cp"
                ? "bold 10px monospace"
                : "10px monospace";

        ctx.fillStyle =
            location.type === "cp"
                ? ATCS_BOARD.colors.location
                : ATCS_BOARD.colors.text;

        ctx.fillText(
            location.name,
            x,
            16
        );

        /*
           Milepost beneath location.
        */

        ctx.font =
            "8px monospace";

        ctx.fillStyle =
            ATCS_BOARD.colors.milepost;

        ctx.fillText(
            "MP " +
            Number(location.mp).toFixed(1),
            x,
            29
        );

        /*
           Vertical location tick.
        */

        ctx.strokeStyle =
            "#333";

        ctx.lineWidth =
            1;

        ctx.beginPath();

        ctx.moveTo(
            x,
            42
        );

        ctx.lineTo(
            x,
            365
        );

        ctx.stroke();

        /*
           Clickable control point overlay.
        */

        if (
            location.type === "cp"
        ) {

            createLocationHitArea(
                location
