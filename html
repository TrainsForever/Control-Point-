/* ============================================================
   5.6 ROUTE VALIDATION
   ============================================================ */

function dispatcherCanLineRoute(route) {

    if (!route) {
        return {
            allowed: false,
            reason: "ROUTE NOT FOUND"
        };
    }

    /*
       Existing Part 3 conflict engine.
    */

    try {
        if (typeof routeSafetyCheck === "function") {

            const result = routeSafetyCheck(route);

            if (result === false) {
                return {
                    allowed: false,
                    reason: "ROUTE CONFLICT"
                };
            }

            if (result && result.allowed === false) {
                return result;
            }
        }
    } catch (e) {}

    /*
       Block protection.
    */

    try {
        if (typeof route.blocks !== "undefined" &&
            typeof isBlockOccupied === "function") {

            for (const block of route.blocks) {

                if (isBlockOccupied(block)) {

                    return {
                        allowed: false,
                        reason: `BLOCK ${block} OCCUPIED`
                    };
                }
            }
        }
    } catch (e) {}

    /*
       Existing route-lock protection.
    */

    if (route.id && CP.dispatcher.lockedRoutes[route.id]) {

        return {
            allowed: false,
            reason: "ROUTE ALREADY LOCKED"
        };
    }

    /*
       Check switch conflicts if route data provides them.
    */

    if (route.switches && Array.isArray(route.switches)) {

        for (const switchId of route.switches) {

            const conflictingRoute =
                Object.values(CP.dispatcher.lockedRoutes)
                    .find(r =>
                        r &&
                        r.switches &&
                        r.switches.includes(switchId)
                    );

            if (conflictingRoute) {

                return {
                    allowed: false,
                    reason: `SWITCH ${switchId} LOCKED`
                };
            }
        }
    }

    return {
        allowed: true,
        reason: "ROUTE CLEAR"
    };
}


/* ============================================================
   5.7 ALIGN ROUTE SWITCHES
   ============================================================ */

function dispatcherAlignRoute(route) {

    if (!route) return false;

    /*
       Use the existing switch alignment system where available.
    */

    try {

        if (typeof alignRouteSwitches === "function") {

            const result = alignRouteSwitches(route);

            if (result === false) {
                dispatcherEvent(
                    `ROUTE ${route.id || "UNKNOWN"} SWITCH ALIGNMENT FAILED`,
                    "error"
                );

                return false;
            }
        }

    } catch (e) {

        console.warn(
            "CONTROL POINT: route switch alignment error",
            e
        );

        return false;
    }

    return true;
}


/* ============================================================
   5.8 LOCK ROUTE
   ============================================================ */

function dispatcherLockRoute(route) {

    if (!route || !route.id) {
        return false;
    }

    CP.dispatcher.lockedRoutes[route.id] = {
        id: route.id,
        origin: route.origin,
        destination: route.destination,
        switches: route.switches
            ? [...route.switches]
            : [],
        blocks: route.blocks
            ? [...route.blocks]
            : [],
        lockedAt: Date.now()
    };

    CP.dispatcher.activeRoutes[route.id] = route;

    /*
       Mirror into existing route state.
    */

    try {
        if (typeof routeLocks !== "undefined") {
            routeLocks[route.id] = true;
        }
    } catch (e) {}

    try {
        if (typeof activeRoutes !== "undefined") {
            activeRoutes[route.id] = route;
        }
    } catch (e) {}

    return true;
}


/* ============================================================
   5.9 RELEASE ROUTE
   ============================================================ */

function dispatcherReleaseRoute(routeId) {

    if (!routeId) return;

    delete CP.dispatcher.lockedRoutes[routeId];
    delete CP.dispatcher.activeRoutes[routeId];

    try {
        if (typeof routeLocks !== "undefined") {
            delete routeLocks[routeId];
        }
    } catch (e) {}

    try {
        if (typeof releaseRoute === "function") {
            releaseRoute(routeId);
        }
    } catch (e) {}

    dispatcherEvent(`ROUTE ${routeId} RELEASED`);
}


/* ============================================================
   5.10 LINE ROUTE
   ============================================================ */

function dispatcherLineRoute(route) {

    if (!route) return false;

    const validation =
        dispatcherCanLineRoute(route);

    if (!validation.allowed) {

        dispatcherEvent(
            `ROUTE ${route.id || "UNKNOWN"} NOT LINED: ${validation.reason}`,
            "error"
        );

        return false;
    }

    if (!dispatcherAlignRoute(route)) {
        return false;
    }

    if (!dispatcherLockRoute(route)) {

        dispatcherEvent(
            `ROUTE ${route.id || "UNKNOWN"} LOCK FAILED`,
            "error"
        );

        return false;
    }

    /*
       Existing route system.
    */

    try {

        if (typeof activateRoute === "function") {
            activateRoute(route);
        }

    } catch (e) {}

    try {

        if (typeof setRouteActive === "function") {
            setRouteActive(route.id, true);
        }

    } catch (e) {}

    dispatcherEvent(
        `ROUTE LINED ${route.origin || "?"} → ${route.destination || "?"}`,
        "route"
    );

    return true;
}


/* ============================================================
   5.11 FIND ROUTES FOR A CONTROL POINT
   ============================================================ */

function getDispatcherRoutesForControlPoint(cpName) {

    if (typeof ROUTES === "undefined") {
        return [];
    }

    return Object.values(ROUTES).filter(route => {

        if (!route) return false;

        return (
            route.origin === cpName ||
            route.destination === cpName ||
            route.from === cpName ||
            route.to === cpName ||
            route.controlPoint === cpName
        );
    });
}


