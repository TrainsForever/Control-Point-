/* ============================================================
   ROUTE CONFLICT CHECK
   ============================================================ */

function routeConflicts(
    requestedRoute
) {

    return CP.routes.some(
        route => {

            if (
                route.id
                === requestedRoute.id
            ) {
                return false;
            }


            if (
                !route.locked
                &&
                !route.cleared
            ) {
                return false;
            }


            const sharedBlock =
                requestedRoute.blocks
                    .some(
                        blockId =>
                            route.blocks
                                .includes(
                                    blockId
                                )
                    );


            const sharedSwitch =
                requestedRoute.switches
                    .some(
                        switchId =>
                            route.switches
                                .includes(
                                    switchId
                                )
                    );


            return (
                sharedBlock
                ||
                sharedSwitch
            );

        }
    );

}


/* ============================================================
   ROUTE REQUEST
   ============================================================ */

function requestRoute(
    routeId
) {

    const route =
        CP.routes.find(
            r =>
                r.id === routeId
        );


    if (!route) {

        notify(
            "ROUTE NOT FOUND",
            "red"
        );

        return false;

    }


    if (
        route.locked
    ) {

        return false;

    }


    if (
        routeConflicts(
            route
        )
    ) {

        radioLog(
            "Route request denied: conflicting route.",
            "alert"
        );

        notify(
            "ROUTE CONFLICT",
            "red"
        );

        return false;

    }


    route.requested =
        true;


    /*
       Actual switch alignment and signal clearance will be
       performed by the interlocking engine in the next part.
    */

    radioLog(
        "Route requested: "
        + route.id,
        "dispatcher"
    );


    return true;

}


/* ============================================================
   ROUTE RELEASE
   ============================================================ */

function releaseRoute(
    routeId
) {

    const route =
        CP.routes.find(
            r =>
                r.id === routeId
        );


    if (!route) {
        return false;
    }


    if (
        route.locked
    ) {

        return false;

    }


    route.requested =
        false;

    route.cleared =
        false;


    route.blocks.forEach(
        blockId => {

            const block =
                CP.territory.blocks
                    .find(
                        b =>
                            b.id === blockId
                    );


            if (
                block
                &&
                !block.occupied
            ) {

                block.lined =
                    false;

                block.linedFor =
                    null;

                block.state =
                    "NORMAL";


                renderBlockState(
                    block
                );

            }

        }
    );


    return true;

}


