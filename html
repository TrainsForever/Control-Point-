        const rect =
            atcsBoard.getBoundingClientRect();

        const x =
            event.clientX -
            rect.left +
            atcsBoard.scrollLeft;

        const mp =
            ATCS_SCALE.xToMile(
                x
            );

        console.log(
            "CONTROL POINT territory position:",
            mp.toFixed(1)
        );
    }
);


