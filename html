/* ============================================================
   5.18 YARD DEPARTURE / ROLL-BY LOGIC
   ============================================================ */

/*
   A train leaving a yard or outbound track begins under the
   applicable restricted departure speed.

   The dispatcher does NOT simply teleport the train onto the
   main line.

   The train must:
      1. Receive a valid route.
      2. Receive a permissive signal.
      3. Enter the controlled track.
      4. Remain at ≤10 MPH through the applicable roll-by area.
      5. Continue until the entire train clears the limit.
*/

function setTrainYardDeparture(train, departureMP, clearanceMP) {

    if (!train) return;

    train.yardDeparture = true;

    train.yardDepartureMP =
        Number(departureMP);

    train.yardClearanceMP =
        Number(clearanceMP);

    train.yardDepartureSpeedLimit = 10;

    train.yardDepartureCleared = false;

    dispatcherEvent(
        `${train.id || train.symbol || "TRAIN"} DEPARTURE AUTHORIZED — ROLL-BY LIMIT 10 MPH`
    );
}


function updateTrainYardDeparture(train) {

    if (!train || !train.yardDeparture) {
        return;
    }

    const frontMP = Number(train.mp);

    const rearMP =
        Number.isFinite(train.rearMP)
            ? Number(train.rearMP)
            : frontMP;

    const clearanceMP =
        Number(train.yardClearanceMP);

    /*
       The whole train must clear the limit.

       Direction is handled separately because mileposts may
       decrease or increase depending on territory direction.
    */

    const direction =
        String(train.direction || "").toUpperCase();

    let cleared = false;

    if (direction === "EAST" || direction === "EASTBOUND") {

        cleared =
            rearMP <= clearanceMP;

    } else {

        cleared =
            rearMP >= clearanceMP;
    }

    if (cleared && !train.yardDepartureCleared) {

        train.yardDepartureCleared = true;

        dispatcherEvent(
            `${train.id || train.symbol || "TRAIN"} CLEAR OF ROLL-BY LIMIT`
        );
    }
}


/* ============================================================
   5.19 TRAIN SPEED ENFORCEMENT
   ============================================================ */

function dispatcherApplySpeedAuthority(train) {

    if (!train) return;

    let limit = Infinity;

    /*
       Yard departure restriction.
    */

    if (
        train.yardDeparture &&
        !train.yardDepartureCleared
    ) {
        limit = Math.min(
            limit,
            train.yardDepartureSpeedLimit || 10
        );
    }

    /*
       Existing authorized-speed engine.
    */

    try {

        if (typeof getTrainAuthorizedSpeed === "function") {

            const authorized =
                getTrainAuthorizedSpeed(train);

            if (Number.isFinite(authorized)) {
                limit = Math.min(limit, authorized);
            }
        }

    } catch (e) {}

    /*
       Do not allow the dispatcher layer to override a
       physical stop signal.
    */

    if (train.signalIndication) {

        const indication =
            String(train.signalIndication).toUpperCase();

        if (
            indication === "STOP" ||
            indication === "STOP AND PROCEED"
        ) {
            limit = 0;
        }
    }

    train.dispatcherSpeedLimit = limit;

    /*
       Apply the cap to whatever Part 4 uses.
    */

    if (Number.isFinite(train.speed)) {

        if (limit === 0) {
            train.speed = 0;
        } else if (
            Number.isFinite(limit) &&
            train.speed > limit
        ) {
            train.speed = limit;
        }
    }
}


/* ============================================================
   5.20 ROUTE OCCUPANCY DISPLAY STATE
   ============================================================ */

function getDispatcherTrackState(trackId, blockId) {

    /*
       Occupied takes priority over route color.

       RED = train physically occupies block
       GREEN = block is lined and protected
       WHITE = normal
    */

    let occupied = false;

    try {

        if (
            typeof isBlockOccupied === "function" &&
            blockId
        ) {
            occupied =
                !!isBlockOccupied(blockId);
        }

    } catch (e) {}

    if (occupied) {
        return "occupied";
    }

    /*
       Search active routes.
    */

    const active =
        Object.values(CP.dispatcher.activeRoutes || {});

    for (const route of active) {

        if (!route) continue;

        if (
            route.blocks &&
            blockId &&
            route.blocks.includes(blockId)
        ) {
            return "lined";
        }

        if (
            route.tracks &&
            trackId &&
            route.tracks.includes(trackId)
        ) {
            return "lined";
        }
    }

    return "normal";
}


