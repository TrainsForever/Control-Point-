/* ============================================================
   7.20 SET TRAIN WAIT COUNT
   ============================================================ */

function setTrainWaitCount(
    train,
    count
) {

    if (!train) {
        return;
    }

    initializeTrainRadio(train);

    const id =
        getTrainRadioID(train);

    train.radioState.state =
        "WAITING_FOR_TRAINS";

    train.radioState.waitingFor =
        [];

    train.radioState.waitCount =
        count;

    train.signalAuthority =
        false;

    train.radioSignal =
        "WAIT";

    /*
       Find trains that are relevant to the hold.

       We prefer trains physically approaching the same
       control point / yard interface.
    */

    const candidates =
        getCandidateConflictingTrains(
            train
        );

    train.radioState.waitingFor =
        candidates
            .slice(
                0,
                count
            )
            .map(
                other =>
                    getTrainRadioID(
                        other
                    )
            );

    if (
        train.radioState.waitingFor.length ===
        0
    ) {

        /*
           If no train currently exists, the instruction still
           becomes a real waiting state. The dispatcher can
           later release the train.
        */

        dispatcherRadio(
            train,
            `${id} waiting for ${count} train${count > 1 ? "s" : ""}, over.`
        );

    } else {

        dispatcherRadio(
            train,
            `${id} signal indication, waiting for ${count} train${count > 1 ? "s" : ""}, over.`
        );
    }

    setTimeout(
        () => {

            crewRadio(
                train,
                `Waiting for ${count} train${count > 1 ? "s" : ""}, ${id}, over.`
            );

        },
        650
    );
}


