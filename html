/* ============================================================
   7.16 SIGNAL INDICATION
   ============================================================ */

function dispatcherGiveSignal(
    train
) {

    if (!train) {
        return;
    }

    initializeTrainRadio(train);

    const id =
        getTrainRadioID(train);

    train.radioState.state =
        "SIGNAL_AUTHORITY";

    train.radioState.signalReceived =
        true;

    train.signalAuthority =
        true;

    /*
       Ask existing Part 3 signal logic where possible.
    */

    let indication =
        "CLEAR";

    try {

        if (
            typeof getTrainAuthorizedSpeed ===
            "function"
        ) {

            const speed =
                getTrainAuthorizedSpeed(
                    train
                );

            if (
                Number.isFinite(speed)
            ) {

                if (speed === 0) {
                    indication = "STOP";
                }

                else if (speed <= 15) {
                    indication = "SLOW";
                }

                else if (speed <= 30) {
                    indication = "MEDIUM";
                }

                else {
                    indication = "CLEAR";
                }
            }
        }

    } catch (e) {}

    train.radioSignal =
        indication;

    dispatcherRadio(
        train,
        `${id} signal indication, over.`
    );

    setTimeout(
        () => {

            crewRadio(
                train,
                `Signal indication, ${id}, over.`
            );

            train.radioState.state =
                "MOVING_IF_AUTHORIZED";

        },
        650
    );
}


