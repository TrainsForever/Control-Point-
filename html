function getPlanSpawnPoint(plan) {

    if (!plan) {
        return null;
    }

    const origin =
        String(
            plan.origin ||
            ""
        ).toUpperCase();

    if (
        origin.includes(
            "CHICAGO"
        )
    ) {

        return {
            ...TRAFFIC_ENTRY_POINTS.CHICAGO
        };
    }

    if (
        origin.includes(
            "ELKHART"
        )
    ) {

        return {
            ...TRAFFIC_ENTRY_POINTS.ELKHART_WEST
        };
    }

    if (
        origin.includes(
            "BELLEVUE"
        )
    ) {

        return {
            mp: 402,

            track: "main1",

            direction: "WEST"
        };
    }

    return null;
}


/* ============================================================
   8.8 CREATE TRAFFIC TRAIN
   ============================================================ */

function createTrafficTrain(plan) {

    if (!plan) {
        return null;
    }

    /*
       Respect active train limit.
    */

    if (
        typeof CP.trains !== "undefined" &&
        Array.isArray(CP.trains) &&
        CP.trains.length >=
        CP.traffic.maximumActiveTrains
    ) {

        return null;
    }

    const spawn =
        getPlanSpawnPoint(
            plan
        );

    if (!spawn) {
        return null;
    }

    const type =
        plan.type ||
        "MANIFEST";

    const length =
        randomTrainLength(
            type
        );

    const consist =
        createConsistProfile(
            type
        );

    /*
       Avoid creating duplicate active symbols.
    */

    const duplicate =
        CP.trains.some(
            train =>
                (
                    train.id ||
                    train.symbol
                ) ===
                plan.symbol
        );

    if (duplicate) {
        return null;
    }

    /*
       Use existing createTrain if available.
    */

    let train = null;

    try {

        if (
            typeof createTrain ===
            "function"
        ) {

            train =
                createTrain({

                    id:
                        plan.symbol,

                    symbol:
                        plan.symbol,

                    mp:
                        spawn.mp,

                    track:
                        spawn.track,

                    direction:
                        plan.direction,

                    type:
                        type,

                    trainType:
                        type,

                    length:
                        length,

                    speed:
                        0,

                    origin:
                        plan.origin,

                    destination:
                        plan.destination,

                    priority:
                        plan.priority,

                    dispatcherTerritory:
                        getDispatcherTerritoryForPlan(
                            plan
                        ),

                    locomotives:
                        consist.locomotives,

                    cars:
                        consist.cars,

                    hasDeparted:
                        false
                });
        }

    } catch (error) {

        console.warn(
            "Traffic train creation failed:",
            error
        );
    }

    /*
       If Part 4's createTrain does not accept an object,
       create a compatible fallback.
    */

    if (!train) {

        train = {

            id:
                plan.symbol,

            symbol:
                plan.symbol,

            mp:
                spawn.mp,

            track:
                spawn.track,

            direction:
                plan.direction,

            type:
                type,

            trainType:
                type,

            length:
                length,

            speed:
                0,

            origin:
                plan.origin,

            destination:
                plan.destination,

            priority:
                plan.priority,

            hasDeparted:
                false,

            locomotives:
                consist.locomotives,

            cars:
                consist.cars
        };

        CP.trains.push(
            train
        );
    }

    /*
       Traffic metadata.
    */

    train.operatingPlan =
        plan;

    train.trafficGenerated =
        true;

    train.trafficCreatedAt =
        Date.now();

    train.priorityValue =
        getTrainPriority(
            train
        );

    initializeTrainRadio(
        train
    );

    CP.traffic.trainsGenerated++;

    dispatcherEvent(
        `${plan.symbol} entered operating queue — ${plan.origin} → ${plan.destination}`
    );

    return train;
}


