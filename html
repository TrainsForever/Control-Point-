        sw.id;


    element.style.left =
        (
            mileToPixel(
                sw.milepost
            ) - 11
        )
        + "px";


    element.style.top =
        (
            trackTop
            + 7
        )
        + "px";


    element.addEventListener(
        "click",
        event => {

            event.stopPropagation();

            if (
                sw.locked
            ) {

                radioLog(
                    sw.id
                    + ": switch locked by route.",
                    "alert"
                );

                notify(
                    "SWITCH LOCKED",
                    "red"
                );

                return;

            }


            const next =
                sw.position
                === "NORMAL"
                    ? "REVERSE"
                    : "NORMAL";


            setSwitchPosition(
                sw.id,
                next
            );


            radioLog(
                sw.id
                + ": "
                + next,
                "dispatcher"
            );

        }
    );


    const main =
        document.createElement(
            "div"
        );


    main.className =
        "switchMain";


    const point =
        document.createElement(
            "div"
        );


    point.className =
        "switchPoint";


    const indicator =
        document.createElement(
            "div"
        );


    indicator.className =
        "switchIndicator";


    element.appendChild(
        main
    );

    element.appendChild(
        point
    );

    element.appendChild(
        indicator
    );


    canvas.appendChild(
        element
    );

}


/* ============================================================
   INTERLOCKING MASTER UPDATE
   ============================================================ */

function updateInterlocking() {

    /*
       First verify route occupancy/conflicts.
    */

    CP.routes.forEach(
        route => {

            if (
                !route.cleared
            ) {
                return;
            }


            if (
                routeHasOccupiedBlock(
                    route
                )
            ) {

                /*
                   The route remains locked while a train is using
                   it. It is not simply deleted because a block
                   becomes occupied.

                   This is important for realistic route locking.
                */

                return;

            }

        }
    );


    updateSignalChain();

}


