/* ============================================================
   PHYSICAL SIGNAL HEAD LOGIC
   ============================================================ */

function updatePhysicalSignalHeads(
    signal
) {

    signal.aspectHeads = [];


    /*
       Stop can always be represented by the available heads.
    */

    if (
        signal.indication === "STOP"
    ) {

        signal.aspectHeads.push(
            "red"
        );

        for (
            let i = 1;
            i < signal.heads;
            i++
        ) {

            signal.aspectHeads.push(
                "off"
            );

        }

        return;

    }


    /*
       Clear

       We intentionally keep the exact lamp arrangement abstract
       here. The ATCS display itself only needs the operational
       state.
    */

    if (
        signal.indication === "CLEAR"
    ) {

        signal.aspectHeads.push(
            "green"
        );

        for (
            let i = 1;
            i < signal.heads;
            i++
        ) {

            signal.aspectHeads.push(
                "off"
            );

        }

        return;

    }


    /*
       Approach-family indication.

       The renderer can later choose the correct physical
       combination for the actual signal head arrangement.
    */

    if (
        signal.indication.includes(
            "APPROACH"
        )
    ) {

        signal.aspectHeads.push(
            "yellow"
        );

        for (
            let i = 1;
            i < signal.heads;
            i++
        ) {

            signal.aspectHeads.push(
                "off"
            );

        }

        return;

    }


    /*
       Medium / Limited / Restricting states.

       The game engine knows the actual indication.
       The visual signal renderer will determine the appropriate
       physical representation when the signal database is filled.
    */

    signal.aspectHeads.push(
        "green"
    );

    for (
        let i = 1;
        i < signal.heads;
        i++
    ) {

        signal.aspectHeads.push(
            "off"
        );

    }

}


