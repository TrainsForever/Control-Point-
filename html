/* ============================================================
   6.17 ROUTE COLORING
   ============================================================ */

function drawATCSRoutes(ctx) {

    const activeRoutes =
        CP.dispatcher &&
        CP.dispatcher.activeRoutes
            ? Object.values(
                CP.dispatcher.activeRoutes
            )
            : [];

    ctx.save();

    ctx.lineWidth =
        3;

    for (
        const route
        of activeRoutes
    ) {

        if (!route) {
            continue;
        }

        /*
           Route data may eventually contain a list of
           milepost points.

           Example:

              route.points = [
                  {mp: 421.5, track:"main1"},
                  {mp: 423.1, track:"main1"}
              ]

           Until then, use route start/end MP if available.
        */

        let points =
            Array.isArray(route.points)
                ? route.points
                : null;

        if (
            !points &&
            Number.isFinite(
                Number(route.fromMP)
            ) &&
            Number.isFinite(
                Number(route.toMP)
            )
        ) {

            points = [
                {
                    mp: route.fromMP,
                    track:
                        route.track ||
                        "main1"
                },

                {
                    mp: route.toMP,
                    track:
                        route.track ||
                        "main1"
                }
            ];
        }

        if (
            !points ||
            points.length < 2
        ) {
            continue;
        }

        ctx.strokeStyle =
            ATCS_BOARD.colors.route;

        ctx.beginPath();

        points.forEach(
            (point, index) => {

                const x =
                    ATCS_SCALE.mileToX(
                        point.mp
                    );

                const y =
                    getTrackY(
                        point.track ||
                        "main1"
                    );

                if (index === 0) {

                    ctx.moveTo(
                        x,
                        y
                    );

                } else {

                    ctx.lineTo(
                        x,
                        y
                    );
                }
            }
        );

        ctx.stroke();
    }

    ctx.restore();
}


/* ============================================================
   6.18 TRAIN OCCUPANCY
   ============================================================ */

function drawATCSTrainOccupancy(ctx) {

    const trains =
        typeof CP !== "undefined" &&
        Array.isArray(CP.trains)
            ? CP.trains
            : [];

    ctx.save();

    ctx.lineWidth =
        4;

    ctx.strokeStyle =
        ATCS_BOARD.colors.occupied;

    for (
        const train
        of trains
    ) {

        if (
            !Number.isFinite(
                Number(train.mp)
            )
        ) {
            continue;
        }

        const frontMP =
            Number(train.mp);

        /*
           Train length in feet.
           Approximate conversion:
              5280 feet = 1 mile
        */

        const lengthFeet =
            Number.isFinite(
                Number(train.length)
            )
                ? Number(train.length)
                : 8000;

        const lengthMiles =
            lengthFeet / 5280;

        const rearMP =
            Number.isFinite(
                Number(train.rearMP)
            )
                ? Number(train.rearMP)
                : (
                    String(
                        train.direction ||
                        ""
                    ).toUpperCase()
                    .includes("EAST")
                        ? frontMP + lengthMiles
                        : frontMP - lengthMiles
                );

        const xFront =
            ATCS_SCALE.mileToX(
                frontMP
            );

        const xRear =
            ATCS_SCALE.mileToX(
                rearMP
            );

        const y =
            getTrackY(
                train.track ||
                "main1"
            );

        /*
           The red occupancy line represents the physical
           train occupancy, not merely the next signal.
        */

        ctx.beginPath();

        ctx.moveTo(
            Math.min(
                xFront,
                xRear
            ),
            y
        );

        ctx.lineTo(
            Math.max(
                xFront,
                xRear
            ),
            y
        );

        ctx.stroke();

        /*
           Train symbol.
        */

        ctx.font =
            "bold 9px monospace";

        ctx.fillStyle =
            ATCS_BOARD.colors.occupied;

        ctx.textAlign =
            "center";

        ctx.fillText(
            train.id ||
            train.symbol ||
            "TRAIN",
            (xFront + xRear) / 2,
            y - 7
        );
    }

    ctx.restore();
}


/* ============================================================
   6.19 MILEPOST RULER
   ============================================================ */

function drawATCSMilepostRuler(ctx) {

    ctx.save();

    ctx.strokeStyle =
        "#222";

    ctx.fillStyle =
        "#666";

    ctx.lineWidth =
        1;

    ctx.font =
        "8px monospace";

    ctx.textAlign =
        "center";

    const start =
        Math.ceil(
            ATCS_SCALE.eastMP
        );

    const end =
        Math.floor(
            ATCS_SCALE.westMP
        );

    for (
        let mp = start;
        mp <= end;
        mp++
    ) {

        const x =
            ATCS_SCALE.mileToX(
                mp
            );

        if (
            x < 0 ||
            x > ATCS_BOARD.width
        ) {
            continue;
        }

        ctx.beginPath();

        ctx.moveTo(
            x,
            395
        );

        ctx.lineTo(
            x,
            401
        );

        ctx.stroke();

        /*
           Every five miles gets a larger marker.
        */

        if (
            mp % 5 === 0
        ) {

            ctx.beginPath();

            ctx.moveTo(
                x,
                392
            );

            ctx.lineTo(
                x,
                404
            );

            ctx.stroke();

            ctx.fillText(
                String(mp),
                x,
                413
            );
        }
    }

    ctx.restore();
}


/* ============================================================
   6.20 BOARD FRAME LABEL
   ============================================================ */

function drawATCSHeader(ctx) {

    ctx.save();

    ctx.font =
        "bold 10px monospace";

    ctx.fillStyle =
        "#aaa";

    ctx.textAlign =
        "left";

    ctx.fillText(
        "CONTROL POINT",
        10,
        8
    );

    ctx.font =
        "8px monospace";

    ctx.fillStyle =
        "#555";

    ctx.fillText(
        "DISPATCHER TERRITORY",
        115,
        8
    );

    ctx.restore();
}


/* ============================================================
   6.21 COMPLETE BOARD RENDER
   ============================================================ */

function renderATCSBoard() {

    const canvas =
        createATCSCanvas();

    const ctx =
        canvas.getContext("2d");

    /*
       Clear.
    */

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    /*
       Black background.
    */

    ctx.fillStyle =
        ATCS_BOARD.colors.background;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    /*
       Layer order matters.
    */

    drawATCSHeader(ctx);

    drawATCSBaseTracks(ctx);

    drawATCSRoutes(ctx);

    drawATCSTrainOccupancy(ctx);

    drawATCSSpeedRestrictions(ctx);

    drawATCSSignals(ctx);

    drawATCSSwitches(ctx);

    drawATCSLocations(ctx);

    drawTrackLabels(ctx);

    drawATCSMilepostRuler(ctx);
}


